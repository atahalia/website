<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= title %> - Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
    <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
</head>
<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar') %>
    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar', { user }) %>
            <div class="container-fluid">

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb" style="background:transparent;padding:0;font-size:.85rem">
                        <li class="breadcrumb-item"><a href="/admin/sk-guru">SK Guru</a></li>
                        <li class="breadcrumb-item active">Detail</li>
                    </ol>
                </nav>

                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800">
                        <i class="fas fa-file-contract mr-2 text-primary"></i>Detail SK Guru
                    </h1>
                    <div class="d-flex" style="gap:8px">
                        <a href="/admin/sk-guru/edit/<%= sk.id %>" class="btn btn-sm btn-warning shadow-sm">
                            <i class="fas fa-edit mr-1"></i>Edit
                        </a>
                        <a href="/admin/sk-guru" class="btn btn-sm btn-secondary shadow-sm">
                            <i class="fas fa-arrow-left mr-1"></i>Kembali
                        </a>
                    </div>
                </div>

                <div class="row">
                    <!-- Info SK -->
                    <div class="col-lg-5 mb-4">
                        <div class="card shadow h-100">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-info-circle mr-2"></i>Informasi SK</h6>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="font-weight-bold" style="width:140px">Jenis</td>
                                        <td>
                                            <% if (sk.jenis === 'sk_mengajar') { %>
                                                <span class="badge badge-primary">SK Mengajar</span>
                                            <% } else if (sk.jenis === 'sk_tugas_tambahan') { %>
                                                <span class="badge badge-success">SK Tugas Tambahan</span>
                                            <% } else { %>
                                                <span class="badge badge-secondary"><%= jenisLabel[sk.jenis] || sk.jenis %></span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-bold">Judul</td>
                                        <td><%= sk.judul %></td>
                                    </tr>
                                    <% if (sk.nomor_sk) { %>
                                    <tr>
                                        <td class="font-weight-bold">Nomor SK</td>
                                        <td><%= sk.nomor_sk %></td>
                                    </tr>
                                    <% } %>
                                    <% if (sk.tahun_ajaran) { %>
                                    <tr>
                                        <td class="font-weight-bold">Tahun Ajaran</td>
                                        <td><%= sk.tahun_ajaran %></td>
                                    </tr>
                                    <% } %>
                                    <% if (sk.deskripsi) { %>
                                    <tr>
                                        <td class="font-weight-bold">Deskripsi</td>
                                        <td><%= sk.deskripsi %></td>
                                    </tr>
                                    <% } %>
                                    <tr>
                                        <td class="font-weight-bold">Dibuat Oleh</td>
                                        <td><%= sk.nama_pembuat || '-' %></td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-bold">Tanggal Upload</td>
                                        <td><%= sk.created_at ? new Date(sk.created_at).toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) : '-' %></td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-bold">Jumlah Penerima</td>
                                        <td><span class="badge badge-info"><%= penerima.length %> guru</span></td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-bold">Sudah Dibaca</td>
                                        <td>
                                            <% var sudahBaca = penerima.filter(function(p){ return p.dibaca; }).length; %>
                                            <span class="badge badge-success"><%= sudahBaca %></span>
                                            <span class="text-muted"> / <%= penerima.length %></span>
                                        </td>
                                    </tr>
                                </table>

                                <% if (sk.file_sk) { %>
                                    <hr>
                                    <div class="text-center">
                                        <p class="font-weight-bold mb-2"><i class="fas fa-file mr-1"></i>File SK:</p>
                                        <a href="/uploads/sk/<%= sk.file_sk %>" target="_blank" class="btn btn-primary btn-sm">
                                            <i class="fas fa-download mr-1"></i>Download / Lihat File
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Daftar penerima -->
                    <div class="col-lg-7 mb-4">
                        <div class="card shadow h-100">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary">
                                    <i class="fas fa-users mr-2"></i>Daftar Penerima SK
                                    <span class="badge badge-primary ml-2"><%= penerima.length %></span>
                                </h6>
                            </div>
                            <div class="card-body p-0">
                                <% if (!penerima || penerima.length === 0) { %>
                                    <div class="text-center py-5 text-muted">
                                        <i class="fas fa-user-slash fa-2x mb-2 d-block" style="opacity:.3"></i>
                                        <p>Belum ada penerima SK.</p>
                                        <a href="/admin/sk-guru/edit/<%= sk.id %>" class="btn btn-sm btn-primary">
                                            <i class="fas fa-plus mr-1"></i>Tambah Penerima
                                        </a>
                                    </div>
                                <% } else { %>
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th style="width:40px">#</th>
                                                    <th>Nama Guru</th>
                                                    <th style="width:130px">NIP</th>
                                                    <th style="width:100px">Status Baca</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% penerima.forEach(function(p, idx) { %>
                                                <tr>
                                                    <td class="text-center text-muted" style="font-size:.82rem"><%= idx+1 %></td>
                                                    <td>
                                                        <div class="d-flex align-items-center" style="gap:10px">
                                                            <% if (p.foto) { %>
                                                                <img src="/uploads/<%= p.foto %>" style="width:32px;height:32px;border-radius:50%;object-fit:cover;flex-shrink:0" alt="">
                                                            <% } else { %>
                                                                <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#4e73df,#224abe);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.78rem;flex-shrink:0;font-weight:700">
                                                                    <%= p.nama ? p.nama.charAt(0).toUpperCase() : '?' %>
                                                                </div>
                                                            <% } %>
                                                            <div>
                                                                <div class="font-weight-bold" style="font-size:.88rem"><%= p.nama %></div>
                                                                <small class="text-muted"><%= p.jabatan || '' %></small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="font-size:.8rem;color:#858796"><%= p.nip || '-' %></td>
                                                    <td class="text-center">
                                                        <% if (p.dibaca) { %>
                                                            <span class="badge badge-success" title="<%= p.tanggal_dibaca ? new Date(p.tanggal_dibaca).toLocaleDateString('id-ID') : '' %>">
                                                                <i class="fas fa-check mr-1"></i>Dibaca
                                                            </span>
                                                        <% } else { %>
                                                            <span class="badge badge-light text-muted">Belum</span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <%- include('../partials/footer') %>
    </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
</body>
</html>
