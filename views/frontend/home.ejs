<body>
    <!-- Navigation -->
    <%- include('partials/navbar') %>

    <!-- Hero Section with Slider -->
    <section class="hero-section">
        <% if (slider && slider.length > 0) { %>
            <div class="hero-slider">
                <% slider.forEach((slide, index) => { %>
                    <% const slidePosisi = slide.posisi_teks || 'tengah'; const slideAnim = slide.animasi_teks || 'slide-up'; %>
                    <div class="hero-slide <%= index === 0 ? 'active' : '' %>" data-bg="/uploads/<%= slide.gambar %>"<% if (index === 0) { %> data-bg-loaded="1" style="background-image:url('/uploads/<%= slide.gambar %>')"<% } %>>
                        <div class="container h-100 d-flex align-items-center">
                            <div class="hero-content-row hero-align-<%= slidePosisi %> w-100">
                                <div class="hero-content hero-anim-<%= slideAnim %>">
                                    <% if (slide.subjudul) { %>
                                        <h2 class="hero-subtitle hero-anim-item"><%= slide.subjudul %></h2>
                                    <% } %>
                                    <h1 class="hero-title hero-anim-item"><%= slide.judul %></h1>
                                    <% if (slide.deskripsi) { %>
                                        <p class="hero-description hero-anim-item"><%= slide.deskripsi %></p>
                                    <% } %>
                                    <% if (slide.link_url && slide.link_text) { %>
                                        <a href="<%= slide.link_url %>" class="btn-hero hero-anim-item"><%= slide.link_text %></a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
                
                <!-- Slider Navigation -->
                <% if (slider.length > 1) { %>
                    <button class="slider-arrow prev" onclick="changeSlide(-1)">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="slider-arrow next" onclick="changeSlide(1)">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    
                    <button class="slider-scroll-nav" onclick="nextSlide()" aria-label="Slide berikutnya" title="Slide berikutnya">
                        <div class="slider-chevrons" aria-hidden="true">
                            <span class="slider-chevron"></span>
                            <span class="slider-chevron"></span>
                        </div>
                    </button>
                <% } %>
            </div>
        <% } else { %>
            <!-- Default Hero � Colorful Animated -->
            <div class="hero-default">
                <!-- Animated orbs -->
                <div class="hero-orb hero-orb-1"></div>
                <div class="hero-orb hero-orb-2"></div>
                <div class="hero-orb hero-orb-3"></div>
                <div class="hero-orb hero-orb-4"></div>
