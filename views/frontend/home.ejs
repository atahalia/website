              <i class="fas fa-clock" style="color:#fbbf24;font-size:1.3rem;"></i>
              <span id="jp-jam-sekarang" style="color:white;font-size:1.1rem;font-weight:700;font-variant-numeric:tabular-nums;min-width:60px;">--:--:--</span>
            </div>
            <div>
              <div style="color:rgba(255,255,255,.7);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;font-weight:600;">Hari ini</div>
              <div id="jp-hari-label" style="color:white;font-size:.95rem;font-weight:700;"></div>
            </div>
          </div>
