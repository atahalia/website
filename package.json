{
  "name": "website-sekolah-smkn1kras",
  "version": "1.0.0",
  "description": "Website Resmi SMK Negeri 1 Kras dengan Node.js dan MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "deploy": "node deploy.js",
    "setup": "node create_admin.js",
    "sync-siswa": "node sync_siswa_from_cbt.js",
    "sync-guru": "node sync_guru_from_cbt.js",
    "backup-db": "mysqldump -u $DB_USER -p$DB_PASSWORD $DB_NAME > backup_$(date +%Y%m%d).sql",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:restart": "pm2 restart website-sekolah",
    "pm2:stop": "pm2 stop website-sekolah",
    "pm2:logs": "pm2 logs website-sekolah"
  },
  "keywords": [
    "school",
    "website",
    "nodejs",
    "mysql",
    "smk",
    "education",
    "cbt-integration"
  ],
  "author": "SMK Negeri 1 Kras",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atahalia/website.git"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.1",
    "compression": "^1.8.1",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.17.3",
    "express-validator": "^7.3.1",
    "face-api.js": "^0.22.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "pm2": "^6.0.14",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "xss": "^1.0.15",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "fast-check": "^4.6.0",
    "jest": "^30.3.0",
    "nodemon": "^3.0.1"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
