<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>MOVE – Melayani Komunitas Via Edukasi | SMKN 1 Kras</title>
  <meta name="description" content="Program pengabdian masyarakat gratis dari SMKN 1 Kras.">
  <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/theme.css">
  <link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
  <style>
    body { font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; color:#1e293b; }

    /* Hero */
    .hero-index { background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 60%,#1a56db 100%); min-height:70vh; display:flex; align-items:center; color:#fff; position:relative; overflow:hidden; }
    .hero-index::before { content:''; position:absolute; inset:0; background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E"); }
    .hero-content { position:relative; z-index:2; text-align:center; padding:80px 0; }
    .move-logo { font-size:clamp(3rem,10vw,6rem); font-weight:900; letter-spacing:-2px; line-height:1; }
    .move-logo span { color:#f59e0b; }
    .hero-stats { display:flex; justify-content:center; flex-wrap:wrap; gap:40px; margin-top:48px; }
    .hidx-stat .num { font-size:2.2rem; font-weight:900; color:#f59e0b; }
    .hidx-stat .lbl { font-size:.8rem; opacity:.7; }

    /* Jurusan cards */
    .jurusan-cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:28px; }
    .j-card { border-radius:24px; overflow:hidden; position:relative; min-height:320px; display:flex; flex-direction:column; justify-content:flex-end; cursor:pointer; transition:transform .3s,box-shadow .3s; text-decoration:none; }
    .j-card:hover { transform:translateY(-8px); box-shadow:0 24px 60px rgba(0,0,0,.2); }
    .j-card-bg { position:absolute; inset:0; background:var(--jgrad); }
    .j-card-bg::after { content:''; position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,.7) 0%,transparent 60%); }
    .j-card-body { position:relative; z-index:2; padding:28px; color:#fff; }
    .j-icon { width:52px; height:52px; border-radius:14px; background:rgba(255,255,255,.2); display:flex; align-items:center; justify-content:center; font-size:1.4rem; margin-bottom:14px; backdrop-filter:blur(8px); }
    .j-badge { display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,.2); backdrop-filter:blur(8px); padding:6px 14px; border-radius:20px; font-size:.78rem; font-weight:600; }

    .section-pad { padding:80px 0; }
    .section-pad-sm { padding:56px 0; }
    .section-label { display:inline-flex; align-items:center; gap:8px; color:#1e3a5f; font-weight:700; font-size:.82rem; letter-spacing:1px; text-transform:uppercase; margin-bottom:12px; }
    .section-label::before { content:''; width:24px; height:3px; background:#f59e0b; border-radius:2px; display:block; }
    .section-title { font-size:clamp(1.6rem,3.5vw,2.4rem); font-weight:800; color:#0f172a; }

    .nilai-card { background:#fff; border-radius:20px; padding:32px 28px; border:1px solid #e8edf4; text-align:center; }
    .nilai-icon { width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg,#1e3a5f,#1a56db); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.6rem; margin:0 auto 18px; }

    footer.mf { background:#0f172a; color:#94a3b8; padding:40px 0 24px; }
    footer.mf .brand { color:#fff; font-weight:800; font-size:1.1rem; margin-bottom:8px; }
    footer.mf .brand span { color:#f59e0b; }
    footer.mf .copy { font-size:.8rem; text-align:center; border-top:1px solid #1e293b; padding-top:20px; margin-top:28px; }

    #lightboxOverlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.92); z-index:9999; align-items:center; justify-content:center; flex-direction:column; }
    #lightboxOverlay.open { display:flex; }
    /* Galeri hover zoom */
    .gi img { transition:transform .4s ease; }
    .gi:hover img { transform:scale(1.07); }
  </style>
</head>
<body>

<!-- ═══ HERO ═══════════════════════════════════════════════════════ -->
<section class="hero-index">
  <div class="container hero-content">
    <div class="move-logo">M<span>O</span>VE</div>
    <div style="font-size:1rem;opacity:.7;margin-top:4px;letter-spacing:3px;text-transform:uppercase">Melayani Komunitas Via Edukasi</div>
    <p style="font-size:1.1rem;opacity:.85;margin:16px 0 32px;max-width:540px;margin-left:auto;margin-right:auto">
      Program <strong style="color:#f59e0b">pengabdian masyarakat gratis</strong> dari siswa-siswi SMKN 1 Kras.<br>
      4 Jurusan &middot; 1 Tujuan &middot; Semua Gratis untuk Komunitas.
    </p>
    <a href="#jurusan" style="display:inline-flex;align-items:center;gap:10px;background:#f59e0b;color:#1e293b;padding:14px 36px;border-radius:40px;font-weight:700;font-size:1rem;text-decoration:none">
      <i class="fas fa-hands-helping"></i> Pilih Jurusan &amp; Daftar Gratis
    </a>
    <div class="hero-stats">
      <div class="hidx-stat"><div class="num"><%= allJurusan.length %></div><div class="lbl">Jurusan Aktif</div></div>
      <div class="hidx-stat"><div class="num"><%= moveStats.total_proyek %>+</div><div class="lbl">Proyek</div></div>
      <div class="hidx-stat"><div class="num">100%</div><div class="lbl">Gratis</div></div>
      <div class="hidx-stat"><div class="num">SMKN 1</div><div class="lbl">Kras, Kediri</div></div>
    </div>
  </div>
</section>

<!-- ═══ TENTANG MOVE ════════════════════════════════════════════════ -->
<section style="padding:72px 0;background:#fff">
  <div class="container">
    <div class="row align-items-center gy-5 mb-5">
      <div class="col-lg-6">
        <div class="section-label"><i class="fas fa-info-circle"></i> Tentang Program</div>
        <h2 class="section-title mb-3">Apa Itu MOVE?</h2>
        <p style="color:#475569;font-size:1rem;line-height:1.85;margin-bottom:16px">
          <%- tentang.move_tentang_p1 || '<strong>MOVE – Melayani Komunitas Via Edukasi</strong> adalah program pengabdian masyarakat gratis dari siswa-siswi SMK Negeri 1 Kras, Kediri.' %>
        </p>
        <% if (tentang.move_tentang_p2) { %>
          <p style="color:#475569;font-size:1rem;line-height:1.85;margin-bottom:24px"><%- tentang.move_tentang_p2 %></p>
        <% } %>
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          <div style="display:flex;align-items:center;gap:10px;background:#eff6ff;padding:10px 18px;border-radius:40px">
            <i class="fas fa-check-circle" style="color:#1e3a5f"></i>
            <span style="font-size:.88rem;font-weight:600;color:#1e3a5f">Gratis untuk semua</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;background:#fef3c7;padding:10px 18px;border-radius:40px">
            <i class="fas fa-check-circle" style="color:#92400e"></i>
            <span style="font-size:.88rem;font-weight:600;color:#92400e">Dibimbing guru profesional</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;background:#f0fdf4;padding:10px 18px;border-radius:40px">
            <i class="fas fa-check-circle" style="color:#064e3b"></i>
            <span style="font-size:.88rem;font-weight:600;color:#064e3b">Langsung ke lokasi komunitas</span>
          </div>
        </div>
      </div>
      <div class="col-lg-5 offset-lg-1">
        <div style="background:linear-gradient(135deg,#1e3a5f 0%,#1a56db 100%);border-radius:24px;padding:36px;color:#fff;position:relative;overflow:hidden">
          <div style="position:absolute;top:-30px;right:-30px;width:140px;height:140px;border-radius:50%;background:rgba(255,255,255,.06)"></div>
          <h4 style="font-weight:800;font-size:1.1rem;margin-bottom:20px"><i class="fas fa-bullseye" style="color:#f59e0b;margin-right:10px"></i>Visi Program</h4>
          <p style="opacity:.9;font-size:.92rem;line-height:1.75;margin-bottom:24px">
            <%= tentang.move_visi || 'Menjadi program pengabdian masyarakat terdepan yang membuktikan bahwa siswa SMK mampu memberikan solusi nyata bagi komunitas.' %>
          </p>
          <h4 style="font-weight:800;font-size:1.1rem;margin-bottom:14px"><i class="fas fa-rocket" style="color:#f59e0b;margin-right:10px"></i>Misi Kami</h4>
          <ul style="padding-left:0;list-style:none;margin:0">
            <% tentang.move_misi_arr.forEach(function(m){ %>
              <li style="display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;font-size:.88rem;opacity:.9">
                <i class="fas fa-arrow-right" style="color:#f59e0b;margin-top:3px;flex-shrink:0"></i><span><%= m %></span>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    </div>

    <!-- Cara Kerja -->
    <div style="background:#f8fafc;border-radius:24px;padding:40px 36px">
      <div class="text-center mb-4">
        <div class="section-label justify-content-center"><i class="fas fa-cogs"></i> Cara Kerja</div>
        <h3 style="font-size:1.5rem;font-weight:800;color:#0f172a">Bagaimana Program MOVE Bekerja?</h3>
      </div>
      <div class="row g-4">
        <% var stepIcons = ['fas fa-users','fas fa-chalkboard-teacher','fas fa-map-marker-alt','fas fa-star']; %>
        <% tentang.steps.forEach(function(s, idx){ %>
          <div class="col-md-6 col-lg-3">
            <div style="text-align:center;padding:24px 16px">
              <div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#1e3a5f,#1a56db);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.3rem;margin:0 auto 14px">
                <i class="<%= stepIcons[idx] %>"></i>
              </div>
              <div style="font-size:.7rem;font-weight:800;color:#f59e0b;letter-spacing:2px;margin-bottom:6px">LANGKAH 0<%= idx+1 %></div>
              <h5 style="font-weight:700;font-size:.95rem;color:#0f172a;margin-bottom:8px"><%= s.judul %></h5>
              <p style="font-size:.85rem;color:#64748b;line-height:1.6;margin:0"><%= s.desc %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- ═══ PILIH JURUSAN ═══════════════════════════════════════════════ -->
<section class="section-pad" id="jurusan" style="background:#f8fafc">
  <div class="container">
    <div class="text-center mb-5">
      <div class="section-label justify-content-center"><i class="fas fa-graduation-cap"></i> 4 Jurusan</div>
      <h2 class="section-title">Pilih Jurusan, Dapatkan Layanan Gratis</h2>
      <p style="color:#64748b;max-width:540px;margin:12px auto 0;line-height:1.7">Setiap jurusan punya keahlian dan layanan unik. Klik untuk melihat detail dan mendaftar.</p>
    </div>
    <div class="jurusan-cards">
      <% allJurusan.forEach(function(j){ %>
        <a href="/move/<%= j.slug %>" class="j-card" style="--jgrad:<%= j.gradient || 'linear-gradient(135deg,#1e3a5f,#1a56db)' %>">
          <div class="j-card-bg"></div>
          <div class="j-card-body">
            <div class="j-icon"><i class="<%= j.icon || 'fas fa-graduation-cap' %>"></i></div>
            <h3><%= j.nama %></h3>
            <p style="opacity:.8;font-size:.88rem;margin-bottom:14px"><%= j.deskripsi_singkat || '' %></p>
            <div class="j-badge"><i class="fas fa-arrow-right"></i> Lihat Layanan &amp; Daftar</div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══ NILAI UTAMA ═════════════════════════════════════════════════ -->
<section class="section-pad">
  <div class="container">
    <div class="text-center mb-5">
      <div class="section-label justify-content-center"><i class="fas fa-heart"></i> Nilai Kami</div>
      <h2 class="section-title">Mengapa Memilih MOVE?</h2>
    </div>
    <div class="row g-4">
      <% var nilaiList = [
        { icon:'fas fa-gift',           judul:'100% Gratis',         desc:'Tidak ada biaya apapun. Semua layanan diberikan sebagai wujud pengabdian masyarakat.' },
        { icon:'fas fa-user-graduate',  judul:'Tenaga Terlatih',     desc:'Dilaksanakan oleh siswa SMK yang telah mendapat pelatihan dan dibimbing guru profesional.' },
        { icon:'fas fa-map-marker-alt', judul:'Datang ke Komunitas', desc:'Kami yang datang ke lokasi Anda. Tidak perlu repot ke sekolah.' },
        { icon:'fas fa-certificate',    judul:'Berorientasi Hasil',  desc:'Setiap kegiatan dirancang memberikan manfaat nyata dan terukur bagi komunitas.' }
      ]; %>
      <% nilaiList.forEach(function(n){ %>
        <div class="col-6 col-md-3">
          <div class="nilai-card">
            <div class="nilai-icon"><i class="<%= n.icon %>"></i></div>
            <h5 style="font-weight:700;margin-bottom:8px"><%= n.judul %></h5>
            <p style="font-size:.85rem;color:#64748b;margin:0;line-height:1.6"><%= n.desc %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══ SEMUA PROYEK ════════════════════════════════════════════════ -->
<% if (allProyek && allProyek.length > 0) { %>
<section class="section-pad" style="background:#f8fafc" id="proyek">
  <div class="container">
    <div class="section-label"><i class="fas fa-project-diagram"></i> Jejak Kegiatan</div>
    <h2 class="section-title mb-2">Proyek yang Pernah Kami Tangani</h2>
    <p style="color:#64748b;max-width:560px;margin:0 0 24px;line-height:1.7">Dokumentasi nyata dari seluruh program MOVE dari tahun ke tahun.</p>

    <!-- Filter -->
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px">
      <button class="pf-btn active" data-val="all" style="padding:5px 16px;border-radius:20px;border:2px solid #1e3a5f;background:#1e3a5f;color:#fff;font-size:.8rem;font-weight:600;cursor:pointer">Semua</button>
      <% allJurusan.forEach(function(j){ %>
        <button class="pf-btn" data-val="<%= j.slug %>" data-color="<%= j.warna1 %>"
          style="padding:5px 16px;border-radius:20px;border:2px solid #e2e8f0;background:#fff;color:#64748b;font-size:.8rem;font-weight:600;cursor:pointer">
          <span style="width:8px;height:8px;border-radius:50%;background:<%= j.warna1 %>;display:inline-block;margin-right:4px"></span>
          <%= singkatJurusan(j.nama) %>
        </button>
      <% }) %>
    </div>

    <div class="row" id="proyekGrid">
      <% allProyek.forEach(function(p){ %>
        <div class="col-md-6 col-lg-4 mb-4 pi" data-slug="<%= p.program_slug %>">
          <div style="background:#fff;border-radius:18px;overflow:hidden;border:1px solid #e8edf4;height:100%">
            <% var pfBg = p.program_gradient || 'linear-gradient(135deg,#1e3a5f,#1a56db)'; %>
            <% var fotos = p.fotos && p.fotos.length > 0 ? p.fotos : (p.gambar ? [{gambar:p.gambar}] : []); %>
            <% if (fotos.length > 0) { %>
              <div class="idx-slider" style="aspect-ratio:4/5;position:relative;overflow:hidden;background:#f8fafc">
                <% fotos.forEach(function(f,fi){ %>
                  <div class="idx-slide" style="position:absolute;inset:0;transition:opacity .6s;opacity:<%= fi===0?1:0 %>;z-index:<%= fi===0?1:0 %>">
                    <img src="/uploads/<%= f.gambar %>" alt="<%= p.judul %>" style="width:100%;height:100%;object-fit:cover" loading="lazy">
                  </div>
                <% }) %>
                <div style="position:absolute;top:10px;left:10px;display:flex;gap:6px;z-index:10">
                  <span style="background:<%= p.program_warna1 %>;color:#fff;padding:3px 10px;border-radius:20px;font-size:.68rem;font-weight:700"><%= p.tahun %></span>
                  <span style="background:rgba(255,255,255,.9);color:<%= p.program_warna1 %>;padding:3px 10px;border-radius:20px;font-size:.68rem;font-weight:700"><%= singkatJurusan(p.program_nama) %></span>
                </div>
                <% if (fotos.length > 1) { %>
                  <div style="position:absolute;bottom:8px;left:0;right:0;display:flex;justify-content:center;gap:5px;z-index:10">
                    <% fotos.forEach(function(f,fi){ %>
                      <span class="idx-dot" data-idx="<%= fi %>" style="width:<%= fi===0?'18px':'7px' %>;height:7px;border-radius:4px;background:rgba(255,255,255,<%= fi===0?.95:.5 %>);transition:all .3s;cursor:pointer"></span>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              <div style="aspect-ratio:4/5;background:<%= pfBg %>;display:flex;align-items:center;justify-content:center;position:relative">
                <i class="fas fa-project-diagram" style="font-size:2.5rem;color:rgba(255,255,255,.35)"></i>
                <div style="position:absolute;top:10px;left:10px;display:flex;gap:6px">
                  <span style="background:rgba(255,255,255,.2);color:#fff;padding:3px 10px;border-radius:20px;font-size:.68rem;font-weight:700"><%= p.tahun %></span>
                </div>
              </div>
            <% } %>
            <div style="padding:16px 18px">
              <h5 style="font-weight:700;font-size:.92rem;color:#0f172a;margin-bottom:6px"><%= p.judul %></h5>
              <% if (p.deskripsi) { %><p style="font-size:.8rem;color:#64748b;line-height:1.55;margin-bottom:8px"><%= p.deskripsi.substring(0,100) %><%= p.deskripsi.length>100?'...':'' %></p><% } %>
              <div style="font-size:.76rem;color:#64748b;line-height:1.85">
                <% if (p.tanggal_pelaksanaan) { %><div>📅 Pelaksanaan: <strong><%= new Date(p.tanggal_pelaksanaan).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}) %></strong></div><% } %>
                <% if (p.jumlah_siswa) { %><div>👨‍🎓 Jumlah Siswa: <strong><%= p.jumlah_siswa %> orang</strong></div><% } %>
                <% if (p.jumlah_item) { %><div>🔧 Jumlah: <strong><%= p.jumlah_item %> <%= p.satuan_item||'Unit' %></strong></div><% } %>
                <% if (p.nama_pelanggan) { %><div>🏢 Pelanggan: <strong><%= p.nama_pelanggan %></strong><% if(p.kategori_pelanggan){ %> (<%= p.kategori_pelanggan %>)<% } %></div><% } %>
                <% if (p.lokasi) { %><div>📍 <%= p.lokasi %></div><% } %>
              </div>
              <!-- Link sosmed proyek -->
              <% var hasLink = p.link_maps||p.link_publikasi||p.link_tiktok||p.link_youtube||p.link_facebook||p.link_twitter||p.link_threads; %>
              <% if (hasLink) { %>
                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;padding-top:10px;border-top:1px solid #f1f5f9">
                  <% if (p.link_maps) { %><a href="<%= p.link_maps %>" target="_blank" style="display:inline-flex;align-items:center;gap:5px;background:#fee2e2;color:#dc2626;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none"><i class="fas fa-map-marker-alt"></i> Lokasi</a><% } %>
                  <% if (p.link_publikasi) { %><a href="<%= p.link_publikasi %>" target="_blank" style="display:inline-flex;align-items:center;gap:5px;background:#fce7f3;color:#db2777;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none"><i class="fab fa-instagram"></i> IG</a><% } %>
                  <% if (p.link_tiktok) { %><a href="<%= p.link_tiktok %>" target="_blank" style="display:inline-flex;align-items:center;gap:5px;background:#f1f5f9;color:#0f172a;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none"><i class="fab fa-tiktok"></i> TikTok</a><% } %>
                  <% if (p.link_youtube) { %><a href="<%= p.link_youtube %>" target="_blank" style="display:inline-flex;align-items:center;gap:5px;background:#fee2e2;color:#ff0000;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none"><i class="fab fa-youtube"></i> YT</a><% } %>
                  <% if (p.link_facebook) { %><a href="<%= p.link_facebook %>" target="_blank" style="display:inline-flex;align-items:center;gap:5px;background:#eff6ff;color:#1877f2;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none"><i class="fab fa-facebook"></i> FB</a><% } %>
                  <% if (p.link_twitter) { %><a href="<%= p.link_twitter %>" target="_blank" style="display:inline-flex;align-items:center;gap:5px;background:#e7f3fd;color:#1da1f2;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none"><i class="fab fa-twitter"></i> Twitter</a><% } %>
                  <% if (p.link_threads) { %><a href="<%= p.link_threads %>" target="_blank" style="display:inline-flex;align-items:center;gap:5px;background:#f1f5f9;color:#0f172a;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none"><i class="fas fa-at"></i> Threads</a><% } %>
                </div>
              <% } %>
              <!-- Anggota tim -->
              <% if (p.anggota && p.anggota.length > 0) { %>
                <div style="margin-top:12px;padding-top:10px;border-top:1px solid #f1f5f9">
                  <p style="font-size:.68rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">Tim Siswa</p>
                  <div style="display:flex;flex-wrap:wrap;gap:5px">
                    <% p.anggota.forEach(function(a){ %>
                      <% var pl = detectPlatformEjs(a.link_publikasi); %>
                      <% if (a.link_publikasi) { %>
                        <a href="<%= a.link_publikasi %>" target="_blank" style="display:inline-flex;align-items:center;gap:5px;background:<%= pl.bg %>;color:<%= pl.color %>;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none">
                          <i class="<%= pl.icon %>"></i> <%= a.nama %>
                        </a>
                      <% } else { %>
                        <span style="display:inline-flex;align-items:center;gap:5px;background:#f8fafc;color:#94a3b8;padding:4px 10px;border-radius:20px;font-size:.72rem">
                          <i class="fas fa-user"></i> <%= a.nama %>
                        </span>
                      <% } %>
                    <% }) %>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══ BERITA TERBARU ══════════════════════════════════════════════ -->
<% if (allBerita && allBerita.length > 0) { %>
<section class="section-pad" style="background:#fff">
  <div class="container">
    <div class="section-label"><i class="fas fa-newspaper"></i> Berita Terbaru</div>
    <h2 class="section-title mb-2">Update dari Semua Program MOVE</h2>
    <p style="color:#64748b;font-size:.95rem;line-height:1.7;margin-bottom:40px">Informasi kegiatan terkini dari seluruh jurusan.</p>
    <div class="row">
      <% allBerita.forEach(function(b, idx){ %>
        <% if (idx === 0) { %>
          <div class="col-lg-6 mb-4">
            <div style="background:#fff;border-radius:20px;overflow:hidden;border:1px solid #e8edf4;height:100%">
              <% if (b.gambar) { %><div style="aspect-ratio:16/9;overflow:hidden"><img src="/uploads/<%= b.gambar %>" alt="<%= b.judul %>" style="width:100%;height:100%;object-fit:cover" loading="lazy"></div>
              <% } else { %><div style="aspect-ratio:16/9;background:<%= b.gradient||'linear-gradient(135deg,#1e3a5f,#1a56db)' %>;display:flex;align-items:center;justify-content:center"><i class="fas fa-newspaper" style="font-size:3rem;color:rgba(255,255,255,.4)"></i></div><% } %>
              <div style="padding:24px">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap">
                  <span style="background:<%= b.warna1 %>18;color:<%= b.warna1 %>;font-size:.72rem;font-weight:700;padding:3px 12px;border-radius:20px"><i class="fas fa-star" style="margin-right:4px"></i>Terbaru</span>
                  <span style="background:#f1f5f9;color:#64748b;font-size:.7rem;padding:3px 10px;border-radius:20px">MOVE <%= singkatJurusan(b.program_nama) %></span>
                </div>
                <h4 style="font-weight:800;margin:0 0 8px;font-size:1.1rem;color:#0f172a"><%= b.judul %></h4>
                <% if (b.ringkasan) { %><p style="font-size:.88rem;color:#64748b;line-height:1.6;margin-bottom:12px"><%= b.ringkasan %></p><% } %>
                <span style="font-size:.8rem;color:#94a3b8"><i class="fas fa-calendar" style="margin-right:4px"></i><%= new Date(b.created_at).toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) %></span>
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="col-lg-2 col-md-4 mb-4">
            <div style="background:#fff;border-radius:16px;overflow:hidden;border:1px solid #e8edf4;height:100%">
              <% if (b.gambar) { %><div style="aspect-ratio:16/9;overflow:hidden"><img src="/uploads/<%= b.gambar %>" alt="<%= b.judul %>" style="width:100%;height:100%;object-fit:cover" loading="lazy"></div>
              <% } else { %><div style="aspect-ratio:16/9;background:<%= b.gradient||'linear-gradient(135deg,#1e3a5f,#1a56db)' %>;display:flex;align-items:center;justify-content:center"><i class="fas fa-newspaper" style="font-size:1.8rem;color:rgba(255,255,255,.4)"></i></div><% } %>
              <div style="padding:14px">
                <span style="background:<%= b.warna1 %>18;color:<%= b.warna1 %>;font-size:.65rem;font-weight:700;padding:2px 8px;border-radius:10px;display:inline-block;margin-bottom:6px"><%= singkatJurusan(b.program_nama) %></span>
                <h6 style="font-weight:700;font-size:.82rem;margin-bottom:4px;color:#0f172a"><%= b.judul %></h6>
                <span style="font-size:.7rem;color:#94a3b8"><%= new Date(b.created_at).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></span>
              </div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══ GALERI KEGIATAN ═════════════════════════════════════════════ -->
<% if (allGaleri && allGaleri.length > 0) { %>
<section class="section-pad-sm" style="background:#f8fafc">
  <div class="container">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px">
      <div>
        <div class="section-label"><i class="fas fa-images"></i> Dokumentasi</div>
        <h2 class="section-title mb-1">Galeri Kegiatan MOVE</h2>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:8px">
        <button class="gf-btn active" data-val="all" style="padding:5px 16px;border-radius:20px;border:2px solid #1e3a5f;background:#1e3a5f;color:#fff;font-size:.8rem;font-weight:600;cursor:pointer">Semua</button>
        <% allJurusan.forEach(function(j){ %>
          <button class="gf-btn" data-val="<%= j.slug %>" data-color="<%= j.warna1 %>"
            style="padding:5px 16px;border-radius:20px;border:2px solid #e2e8f0;background:#fff;color:#64748b;font-size:.8rem;font-weight:600;cursor:pointer">
            <span style="width:8px;height:8px;border-radius:50%;background:<%= j.warna1 %>;display:inline-block;margin-right:4px"></span>
            <%= singkatJurusan(j.nama) %>
          </button>
        <% }) %>
      </div>
    </div>
    <div style="columns:2;column-gap:12px" id="galeriGrid">
      <% allGaleri.forEach(function(g){ %>
        <div class="gi" data-slug="<%= g.program_slug %>"
          data-src="/uploads/<%= g.gambar %>"
          data-cap="<%= encodeURIComponent(g.judul||'') %>"
          data-prog="<%= encodeURIComponent(g.program_nama||'') %>"
          style="break-inside:avoid;margin-bottom:12px;border-radius:12px;overflow:hidden;position:relative;cursor:pointer">
          <img src="/uploads/<%= g.gambar %>" alt="<%= g.judul||'Galeri MOVE' %>"
            style="width:100%;display:block" loading="lazy">
          <div style="position:absolute;bottom:8px;left:8px">
            <span style="background:<%= g.warna1 %>;color:#fff;font-size:.65rem;font-weight:700;padding:2px 8px;border-radius:10px"><%= singkatJurusan(g.program_nama) %></span>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ═══ STATISTIK + PETA ════════════════════════════════════════════ -->
<section class="section-pad" id="peta-gabungan">
  <div class="container">

    <!-- Statistik + label tepat di atas peta -->
    <p style="font-size:.68rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#94a3b8;text-align:center;margin-bottom:12px">
      DATA MOVE SMKN 1 KRAS SEJAK <%= moveStats.tahun_mulai %>
    </p>
    <div style="display:flex;flex-wrap:wrap;justify-content:space-evenly;align-items:center;background:#f8fafc;border-radius:16px;border:1px solid #e2e8f0;padding:20px 0;margin-bottom:12px">
      <% var statsArr = [
        { icon:'fas fa-project-diagram',    val: moveStats.total_proyek,    lbl:'Proyek',         color:'#1a56db' },
        { icon:'fas fa-users',              val: moveStats.total_siswa,     lbl:'Siswa Terlibat', color:'#0891b2' },
        { icon:'fas fa-map-marker-alt',     val: moveStats.total_pelanggan, lbl:'Titik Layanan',  color:'#059669' },
        { icon:'fas fa-graduation-cap',     val: moveStats.total_jurusan,   lbl:'Jurusan Aktif',  color:'#dc2626' },
        { icon:'fas fa-calendar-check',     val: (new Date().getFullYear() - moveStats.tahun_mulai + 1), lbl:'Tahun Berjalan', color:'#7c3aed' },
        { icon:'fas fa-hand-holding-heart', val:'100%',                     lbl:'Gratis',         color:'#d97706' }
      ]; %>
      <% statsArr.forEach(function(s){ %>
        <div style="display:flex;flex-direction:column;align-items:center;gap:6px;padding:8px 16px;text-align:center;flex:1">
          <i class="<%= s.icon %>" style="font-size:1.6rem;color:<%= s.color %>"></i>
          <div style="font-size:1.5rem;font-weight:900;color:<%= s.color %>;line-height:1">
            <%= typeof s.val === 'number' ? s.val.toLocaleString('id-ID') : s.val %>
          </div>
          <div style="font-size:.65rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px"><%= s.lbl %></div>
        </div>
      <% }) %>
    </div>

    <!-- Legend jurusan kanan atas peta -->
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:12px">
      <div>
        <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:8px">
          <div style="height:2px;width:28px;background:linear-gradient(90deg,#1e3a5f,#1a56db);border-radius:2px"></div>
          <span style="font-size:.78rem;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#1e3a5f"><i class="fas fa-map-marked-alt" style="margin-right:6px"></i>Sebaran Layanan</span>
        </div>
        <h2 style="font-size:clamp(1.4rem,3vw,2rem);font-weight:800;color:#0f172a;margin:0 0 4px">Peta Semua Lokasi yang Pernah Kami Tangani</h2>
        <p style="color:#64748b;font-size:.9rem;margin:0">Setiap titik adalah komunitas nyata yang sudah merasakan manfaat program MOVE.</p>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
        <% allJurusan.forEach(function(j){ %>
          <div style="display:flex;align-items:center;gap:6px;font-size:.8rem;font-weight:600;color:#475569">
            <span style="width:12px;height:12px;border-radius:50%;background:<%= j.warna1 %>;display:inline-block;flex-shrink:0"></span>
            <%= singkatJurusan(j.nama) %>
          </div>
        <% }) %>
      </div>
    </div>
    <div style="border-radius:20px;overflow:hidden;border:2px solid #e2e8f0;box-shadow:0 4px 24px rgba(0,0,0,.08)">
      <div id="moveIndexMap" style="height:500px"></div>
    </div>
    <p style="font-size:.8rem;color:#94a3b8;margin-top:12px;text-align:center">
      <i class="fas fa-info-circle" style="margin-right:4px"></i>Klik titik untuk detail lokasi. Peta menggunakan <a href="https://openstreetmap.org" target="_blank" style="color:#94a3b8">OpenStreetMap</a>.
    </p>
  </div>
</section>

<!-- ═══ FOOTER ══════════════════════════════════════════════════════ -->
<footer class="mf">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-5">
        <div class="brand">MOVE <span>SMKN 1 Kras</span></div>
        <p style="font-size:.88rem;line-height:1.7">Program pengabdian masyarakat gratis dari siswa-siswi SMK Negeri 1 Kras, Kediri, Jawa Timur.</p>
      </div>
      <div class="col-md-4">
        <p style="color:#fff;font-weight:700;margin-bottom:14px">Program Jurusan</p>
        <% allJurusan.forEach(function(j){ %>
          <a href="/move/<%= j.slug %>" style="color:#94a3b8;font-size:.88rem;display:block;margin-bottom:6px;text-decoration:none"><i class="<%= j.icon||'fas fa-graduation-cap' %> mr-2"></i><%= j.nama %></a>
        <% }) %>
      </div>
      <div class="col-md-3">
        <p style="color:#fff;font-weight:700;margin-bottom:14px">Kontak</p>
        <p style="font-size:.85rem;line-height:2">
          <i class="fas fa-map-marker-alt" style="margin-right:8px"></i>Kras, Kediri, Jawa Timur<br>
          <i class="fas fa-globe" style="margin-right:8px"></i><a href="https://smkn1kras.sch.id" style="color:#94a3b8;text-decoration:none">smkn1kras.sch.id</a>
        </p>
      </div>
    </div>
    <div class="copy">&copy; <%= new Date().getFullYear() %> MOVE – SMKN 1 Kras &middot; Melayani Komunitas Via Edukasi &middot; Semua Layanan Gratis</div>
  </div>
</footer>

<!-- Lightbox -->
<div id="lightboxOverlay" onclick="closeLightbox()">
  <img id="lightboxImg" src="" style="max-width:90vw;max-height:80vh;border-radius:12px;object-fit:contain">
  <p id="lightboxCap" style="color:#fff;font-size:.9rem;margin:12px 0 0;text-align:center"></p>
  <button onclick="closeLightbox()" style="position:absolute;top:20px;right:24px;background:none;border:none;color:#fff;font-size:2rem;cursor:pointer">&times;</button>
</div>

<script src="/assets/vendor/leaflet/leaflet.js"></script>
<script>
// Slider proyek (idx-slider)
document.querySelectorAll('.idx-slider').forEach(function(slider){
  var slides = slider.querySelectorAll('.idx-slide');
  var dots   = slider.querySelectorAll('.idx-dot');
  if (slides.length <= 1) return;
  var cur = 0;
  function goTo(n) {
    slides[cur].style.opacity = '0'; slides[cur].style.zIndex = '0';
    dots[cur] && (dots[cur].style.width='7px', dots[cur].style.background='rgba(255,255,255,.5)');
    cur = (n + slides.length) % slides.length;
    slides[cur].style.opacity = '1'; slides[cur].style.zIndex = '1';
    dots[cur] && (dots[cur].style.width='18px', dots[cur].style.background='rgba(255,255,255,.95)');
  }
  var t = setInterval(function(){ goTo(cur+1); }, 3000);
  dots.forEach(function(d,i){ d.addEventListener('click',function(e){ e.stopPropagation(); clearInterval(t); goTo(i); t=setInterval(function(){goTo(cur+1);},3000); }); });
  slider.addEventListener('mouseenter', function(){ clearInterval(t); });
  slider.addEventListener('mouseleave', function(){ t=setInterval(function(){goTo(cur+1);},3000); });
});

// Smooth scroll
document.querySelectorAll('a[href^="#"]').forEach(function(el){
  el.addEventListener('click',function(e){ var t=document.querySelector(this.getAttribute('href')); if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'});} });
});

// Filter proyek
document.querySelectorAll('.pf-btn').forEach(function(btn){
  btn.addEventListener('click', function(){
    var val = this.dataset.val;
    document.querySelectorAll('.pf-btn').forEach(function(b){ b.style.background='#fff'; b.style.color='#64748b'; b.style.borderColor='#e2e8f0'; });
    var c = this.dataset.color || '#1e3a5f';
    if (val==='all') c='#1e3a5f';
    this.style.background=c; this.style.color='#fff'; this.style.borderColor=c;
    document.querySelectorAll('.pi').forEach(function(el){ el.style.display=(val==='all'||el.dataset.slug===val)?'':'none'; });
  });
});

// Filter galeri
document.querySelectorAll('.gf-btn').forEach(function(btn){
  btn.addEventListener('click', function(){
    var val = this.dataset.val;
    document.querySelectorAll('.gf-btn').forEach(function(b){ b.style.background='#fff'; b.style.color='#64748b'; b.style.borderColor='#e2e8f0'; });
    var c = this.dataset.color || '#1e3a5f';
    if (val==='all') c='#1e3a5f';
    this.style.background=c; this.style.color='#fff'; this.style.borderColor=c;
    document.querySelectorAll('.gi').forEach(function(el){ el.style.display=(val==='all'||el.dataset.slug===val)?'':'none'; });
  });
});

// Galeri klik = lightbox
document.querySelectorAll('.gi').forEach(function(el){
  el.addEventListener('click', function(){
    document.getElementById('lightboxImg').src = this.dataset.src;
    document.getElementById('lightboxCap').textContent = decodeURIComponent(this.dataset.cap||'') + (this.dataset.prog ? ' — MOVE ' + decodeURIComponent(this.dataset.prog) : '');
    document.getElementById('lightboxOverlay').classList.add('open');
    document.body.style.overflow='hidden';
  });
});
function closeLightbox(){ document.getElementById('lightboxOverlay').classList.remove('open'); document.body.style.overflow=''; }
document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeLightbox(); });

// Slider proyek
document.querySelectorAll('.proyek-slider-idx').forEach(function(slider){
  var slides=slider.querySelectorAll('.slide-item-idx'); var dots=slider.querySelectorAll('.dot-idx');
  if(slides.length<=1) return;
  var cur=0;
  function goTo(n){ slides[cur].style.opacity='0';slides[cur].style.zIndex='0';dots[cur]&&(dots[cur].style.width='7px',dots[cur].style.background='rgba(255,255,255,.5)');cur=(n+slides.length)%slides.length;slides[cur].style.opacity='1';slides[cur].style.zIndex='1';dots[cur]&&(dots[cur].style.width='18px',dots[cur].style.background='rgba(255,255,255,.95)'); }
  var t=setInterval(function(){goTo(cur+1);},3000);
  dots.forEach(function(d,i){d.addEventListener('click',function(e){e.stopPropagation();clearInterval(t);goTo(i);t=setInterval(function(){goTo(cur+1);},3000);});});
  slider.addEventListener('mouseenter',function(){clearInterval(t);});
  slider.addEventListener('mouseleave',function(){t=setInterval(function(){goTo(cur+1);},3000);});
});

// Peta Leaflet
if(document.getElementById('moveIndexMap')){
  var idxMap=L.map('moveIndexMap').setView([-7.822,112.012],12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; <a href="https://openstreetmap.org">OpenStreetMap</a>'}).addTo(idxMap);
  function makePin(color){
    var svg='<svg xmlns="http://www.w3.org/2000/svg" width="28" height="38" viewBox="0 0 28 38"><ellipse cx="14" cy="35" rx="5" ry="2" fill="rgba(0,0,0,0.15)"/><path d="M14 0C8.477 0 4 4.477 4 10c0 7.5 10 24 10 24S24 17.5 24 10C24 4.477 19.523 0 14 0z" fill="'+color+'" stroke="rgba(0,0,0,.1)" stroke-width="0.5"/><circle cx="14" cy="10" r="5" fill="white" opacity="0.9"/></svg>';
    return L.divIcon({html:svg,iconSize:[28,38],iconAnchor:[14,38],popupAnchor:[0,-36],className:''});
  }
  fetch('/api/move/pelanggan')
    .then(function(r){return r.json();})
    .then(function(data){
      if(!data.length) return;
      var bounds=[];
      data.forEach(function(k){
        var icon=makePin(k.warna1||'#1e3a5f');
        var gUrl='https://www.google.com/maps?q='+k.lat+','+k.lng;
        var popup='<div style="min-width:200px;font-family:sans-serif"><strong style="font-size:.9rem">'+k.nama+'</strong><br>'+(k.alamat?'<span style="font-size:.78rem;color:#666">'+k.alamat+'</span><br>':'')+'<span style="font-size:.78rem;color:#666">MOVE '+k.program_nama+' &middot; '+k.tahun+'</span><br><a href="'+gUrl+'" target="_blank" style="font-size:.78rem;color:#1a56db;font-weight:600;display:inline-block;margin-top:6px">Buka di Google Maps</a></div>';
        L.marker([k.lat,k.lng],{icon:icon}).addTo(idxMap).bindPopup(popup,{maxWidth:240});
        bounds.push([k.lat,k.lng]);
      });
      if(bounds.length) idxMap.fitBounds(bounds,{padding:[40,40],maxZoom:14});
    }).catch(function(){});
}
</script>
</body>
</html>
