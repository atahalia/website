<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>MOVE – Melayani Komunitas Via Edukasi | SMKN 1 Kras</title>
  <meta name="description" content="MOVE adalah program pengabdian masyarakat gratis dari SMKN 1 Kras – 4 jurusan, ratusan layanan untuk komunitas.">
  <link href="/assets/vendor/bootstrap5/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome6/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/theme.css">
  <link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
  <style>
    body { font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; color:#1e293b; }
    .hero-index {
      background: linear-gradient(135deg,#0f172a 0%,#1e3a5f 60%,#1a56db 100%);
      min-height: 70vh; display:flex; align-items:center; color:#fff;
      position:relative; overflow:hidden;
    }
    .hero-index::before {
      content:''; position:absolute; inset:0;
      background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
    }
    .hero-index-content { position:relative; z-index:2; text-align:center; padding:80px 0; }
    .move-logo { font-size:clamp(3rem,10vw,6rem); font-weight:900; letter-spacing:-2px; line-height:1; }
    .move-logo span { color:#f59e0b; }
    .move-tagline { font-size:1.2rem; opacity:.85; margin:16px 0 32px; }
    .move-tagline strong { color:#f59e0b; }
    .hero-index-stats { display:flex; justify-content:center; flex-wrap:wrap; gap:40px; margin-top:48px; }
    .hidx-stat .num { font-size:2.2rem; font-weight:900; color:#f59e0b; }
    .hidx-stat .lbl { font-size:.8rem; opacity:.7; }

    /* Jurusan cards */
    .jurusan-cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:28px; }
    .j-card {
      border-radius:24px; overflow:hidden; position:relative;
      min-height:340px; display:flex; flex-direction:column; justify-content:flex-end;
      cursor:pointer; transition:transform .3s, box-shadow .3s;
      text-decoration:none;
    }
    .j-card:hover { transform:translateY(-8px); box-shadow:0 24px 60px rgba(0,0,0,.2); }
    .j-card-bg {
      position:absolute; inset:0;
      background:var(--jgrad);
    }
    .j-card-bg::after {
      content:''; position:absolute; inset:0;
      background:linear-gradient(to top, rgba(0,0,0,.7) 0%, transparent 60%);
    }
    .j-card-body { position:relative; z-index:2; padding:28px; color:#fff; }
    .j-icon { width:52px; height:52px; border-radius:14px; background:rgba(255,255,255,.2); display:flex; align-items:center; justify-content:center; font-size:1.4rem; margin-bottom:14px; backdrop-filter:blur(8px); }
    .j-card h3 { font-size:1.3rem; font-weight:800; margin-bottom:6px; }
    .j-card p { font-size:.85rem; opacity:.8; margin-bottom:16px; line-height:1.5; }
    .j-badge { display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,.2); backdrop-filter:blur(8px); padding:6px 14px; border-radius:20px; font-size:.78rem; font-weight:600; }

    .section-pad { padding:80px 0; }
    .section-label { display:inline-flex; align-items:center; gap:8px; color:#1e3a5f; font-weight:700; font-size:.82rem; letter-spacing:1px; text-transform:uppercase; margin-bottom:12px; }
    .section-label::before { content:''; width:24px; height:3px; background:#f59e0b; border-radius:2px; display:block; }
    .section-title { font-size:clamp(1.6rem,3.5vw,2.4rem); font-weight:800; color:#0f172a; }

    .nilai-card { background:#fff; border-radius:20px; padding:32px 28px; border:1px solid #e8edf4; text-align:center; }
    .nilai-icon { width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg,#1e3a5f,#1a56db); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.6rem; margin:0 auto 18px; }

    footer.mf { background:#0f172a; color:#94a3b8; padding:40px 0 24px; }
    footer.mf .brand { color:#fff; font-weight:800; font-size:1.1rem; margin-bottom:8px; }
    footer.mf .brand span { color:#f59e0b; }
    footer.mf .copy { font-size:.8rem; text-align:center; border-top:1px solid #1e293b; padding-top:20px; margin-top:28px; }
  </style>
</head>
<body>

<!-- HERO -->
<section class="hero-index">
  <div class="container hero-index-content">
    <div class="move-logo">M<span>O</span>VE</div>
    <div style="font-size:1rem;opacity:.7;margin-top:4px;letter-spacing:3px;text-transform:uppercase">Melayani Komunitas Via Edukasi</div>
    <p class="move-tagline">Program <strong>pengabdian masyarakat gratis</strong> dari siswa-siswi SMKN 1 Kras.<br>4 Jurusan · 1 Tujuan · Semua Gratis untuk Komunitas.</p>
    <a href="#jurusan" style="display:inline-flex;align-items:center;gap:10px;background:#f59e0b;color:#1e293b;padding:14px 36px;border-radius:40px;font-weight:700;font-size:1rem;text-decoration:none;transition:transform .2s" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='none'">
      <i class="fas fa-hands-helping"></i> Pilih Jurusan & Daftar Gratis
    </a>
    <div class="hero-index-stats">
      <div class="hidx-stat"><div class="num">4</div><div class="lbl">Jurusan Aktif</div></div>
      <div class="hidx-stat"><div class="num">500+</div><div class="lbl">Penerima Manfaat</div></div>
      <div class="hidx-stat"><div class="num">100%</div><div class="lbl">Gratis</div></div>
      <div class="hidx-stat"><div class="num">SMKN 1</div><div class="lbl">Kras, Kediri</div></div>
    </div>
  </div>
</section>

<!-- TENTANG MOVE -->
<section style="padding:72px 0;background:#fff;position:relative;overflow:hidden">
  <!-- Dekorasi latar -->
  <div style="position:absolute;top:-80px;right:-80px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(30,58,95,.06) 0%,transparent 70%);pointer-events:none"></div>
  <div style="position:absolute;bottom:-60px;left:-60px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,.07) 0%,transparent 70%);pointer-events:none"></div>

  <div class="container">
    <!-- Intro utama -->
    <div class="row align-items-center gy-5 mb-5">
      <div class="col-lg-6">
        <div class="section-label"><i class="fas fa-info-circle"></i> Tentang Program</div>
        <h2 class="section-title mb-3">Apa Itu MOVE?</h2>
        <p style="color:#475569;font-size:1rem;line-height:1.85;margin-bottom:16px">
          <%- tentang.move_tentang_p1 || '<strong>MOVE - Melayani Komunitas Via Edukasi</strong> adalah program pengabdian masyarakat gratis yang dijalankan oleh siswa-siswi SMK Negeri 1 Kras, Kediri.' %>
        </p>
        <% if (tentang.move_tentang_p2) { %>
          <p style="color:#475569;font-size:1rem;line-height:1.85;margin-bottom:24px"><%- tentang.move_tentang_p2 %></p>
        <% } else { %>
          <p style="color:#475569;font-size:1rem;line-height:1.85;margin-bottom:24px">Setiap jurusan membawa keahliannya langsung ke tengah masyarakat � semuanya <strong>gratis, tanpa syarat</strong>.</p>
        <% } %>
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          <div style="display:flex;align-items:center;gap:10px;background:#eff6ff;padding:10px 18px;border-radius:40px">
            <i class="fas fa-check-circle" style="color:#1e3a5f"></i>
            <span style="font-size:.88rem;font-weight:600;color:#1e3a5f">Gratis untuk semua</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;background:#fef3c7;padding:10px 18px;border-radius:40px">
            <i class="fas fa-check-circle" style="color:#92400e"></i>
            <span style="font-size:.88rem;font-weight:600;color:#92400e">Dibimbing guru profesional</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;background:#f0fdf4;padding:10px 18px;border-radius:40px">
            <i class="fas fa-check-circle" style="color:#064e3b"></i>
            <span style="font-size:.88rem;font-weight:600;color:#064e3b">Langsung ke lokasi komunitas</span>
          </div>
        </div>
      </div>
      <div class="col-lg-5 offset-lg-1">
        <div style="background:linear-gradient(135deg,#1e3a5f 0%,#1a56db 100%);border-radius:24px;padding:36px;color:#fff;position:relative;overflow:hidden">
          <div style="position:absolute;top:-30px;right:-30px;width:140px;height:140px;border-radius:50%;background:rgba(255,255,255,.06)"></div>
          <h4 style="font-weight:800;font-size:1.1rem;margin-bottom:20px">
            <i class="fas fa-bullseye" style="color:#f59e0b;margin-right:10px"></i>Visi Program
          </h4>
          <p style="opacity:.9;font-size:.92rem;line-height:1.75;margin-bottom:24px">
            <%= tentang.move_visi || 'Menjadi program pengabdian masyarakat terdepan di Jawa Timur yang membuktikan bahwa siswa SMK mampu memberikan solusi nyata bagi komunitas.' %>
          </p>
          <h4 style="font-weight:800;font-size:1.1rem;margin-bottom:14px">
            <i class="fas fa-rocket" style="color:#f59e0b;margin-right:10px"></i>Misi Kami
          </h4>
          <ul style="padding-left:0;list-style:none;margin:0">
            <% tentang.move_misi_arr.forEach(function(m){ %>
              <li style="display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;font-size:.88rem;opacity:.9">
                <i class="fas fa-arrow-right" style="color:#f59e0b;margin-top:3px;flex-shrink:0"></i><span><%= m %></span>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>

    <!-- Cara kerja -->
    <div style="background:#f8fafc;border-radius:24px;padding:40px 36px">
      <div class="text-center mb-4">
        <div class="section-label justify-content-center"><i class="fas fa-cogs"></i> Cara Kerja</div>
        <h3 style="font-size:1.5rem;font-weight:800;color:#0f172a">Bagaimana Program MOVE Bekerja?</h3>
      </div>
      <div class="row g-4">
        <% var stepIcons = ['fas fa-users','fas fa-chalkboard-teacher','fas fa-map-marker-alt','fas fa-star']; %>
        <% tentang.steps.forEach(function(s, idx){ %>
          <div class="col-md-6 col-lg-3">
            <div style="text-align:center;padding:24px 16px">
              <div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#1e3a5f,#1a56db);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.3rem;margin:0 auto 14px">
                <i class="<%= stepIcons[idx] %>"></i>
              </div>
              <div style="font-size:.7rem;font-weight:800;color:#f59e0b;letter-spacing:2px;margin-bottom:6px">LANGKAH 0<%= idx+1 %></div>
              <h5 style="font-weight:700;font-size:.95rem;color:#0f172a;margin-bottom:8px"><%= s.judul %></h5>
              <p style="font-size:.85rem;color:#64748b;line-height:1.6;margin:0"><%= s.desc %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- PILIH JURUSAN -->
<section class="section-pad" id="jurusan" style="background:#f8fafc">
  <div class="container">
    <div class="text-center mb-5">
      <div class="section-label justify-content-center"><i class="fas fa-graduation-cap"></i> 4 Jurusan</div>
      <h2 class="section-title">Pilih Jurusan, Dapatkan Layanan Gratis</h2>
      <p style="color:#64748b;max-width:540px;margin:12px auto 0;line-height:1.7">Setiap jurusan punya keahlian dan layanan unik. Klik untuk melihat detail dan mendaftar.</p>
    </div>
    <div class="jurusan-cards">
      <% allJurusan.forEach(function(j){ %>
        <a href="/move/<%= j.slug %>" class="j-card" style="--jgrad:<%= j.gradient || 'linear-gradient(135deg,#1e3a5f,#1a56db)' %>">
          <div class="j-card-bg"></div>
          <div class="j-card-body">
            <div class="j-icon"><i class="<%= j.icon || 'fas fa-graduation-cap' %>"></i></div>
            <h3><%= j.nama %></h3>
            <p><%= j.deskripsi_singkat || 'Layanan pengabdian masyarakat gratis dari jurusan ini.' %></p>
            <div class="j-badge"><i class="fas fa-arrow-right"></i> Lihat Layanan & Daftar</div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- NILAI UTAMA -->
<section class="section-pad">
  <div class="container">
    <div class="text-center mb-5">
      <div class="section-label justify-content-center"><i class="fas fa-heart"></i> Nilai Kami</div>
      <h2 class="section-title">Mengapa Memilih MOVE?</h2>
    </div>
    <div class="row g-4">
      <% var nilai = [
        { icon:'fas fa-gift',            judul:'100% Gratis',       desc:'Tidak ada biaya apapun. Semua layanan diberikan sebagai wujud pengabdian masyarakat.' },
        { icon:'fas fa-user-graduate',   judul:'Tenaga Terlatih',   desc:'Dilaksanakan oleh siswa SMK yang telah mendapat pelatihan dan dibimbing guru profesional.' },
        { icon:'fas fa-map-marker-alt',  judul:'Datang ke Komunitas', desc:'Kami yang datang ke lokasi Anda. Tidak perlu repot ke sekolah.' },
        { icon:'fas fa-certificate',     judul:'Berorientasi Hasil', desc:'Setiap kegiatan dirancang memberikan manfaat nyata dan terukur bagi komunitas.' }
      ]; %>
      <% nilai.forEach(function(n){ %>
        <div class="col-6 col-md-3">
          <div class="nilai-card">
            <div class="nilai-icon"><i class="<%= n.icon %>"></i></div>
            <h5 style="font-weight:700;margin-bottom:8px"><%= n.judul %></h5>
            <p style="font-size:.85rem;color:#64748b;margin:0;line-height:1.6"><%= n.desc %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- SEMUA PROYEK GABUNGAN -->
<section class="section-pad" style="background:#f8fafc" id="proyek">
  <div class="container">
    <div class="text-center mb-5">
      <div class="section-label justify-content-center"><i class="fas fa-project-diagram"></i> Jejak Kegiatan</div>
      <h2 class="section-title">Proyek yang Pernah Kami Tangani</h2>
      <p style="color:#64748b;max-width:560px;margin:12px auto 0;line-height:1.7">Dokumentasi nyata dari seluruh program MOVE — dari semua jurusan, dari tahun ke tahun.</p>
    </div>

    <!-- Filter jurusan + tahun -->
    <% if (allProyek && allProyek.length > 0) { %>
      <% var tahunList = [...new Set(allProyek.map(function(p){return p.tahun}))].sort(function(a,b){return b-a}); %>
      <div class="d-flex flex-wrap align-items-center mb-4" style="gap:10px">
        <span style="font-size:.82rem;font-weight:700;color:#64748b;margin-right:4px">Jurusan:</span>
        <button class="idx-filter active" data-filter="jurusan" data-val="all"
          style="padding:5px 16px;border-radius:20px;border:2px solid #1e3a5f;background:#1e3a5f;color:#fff;font-size:.8rem;font-weight:600;cursor:pointer">Semua</button>
        <% allJurusan.forEach(function(j){ %>
          <button class="idx-filter" data-filter="jurusan" data-val="<%= j.slug %>"
            style="padding:5px 16px;border-radius:20px;border:2px solid #e2e8f0;background:#fff;color:#64748b;font-size:.8rem;font-weight:600;cursor:pointer;transition:all .2s"
            data-color="<%= j.warna1 %>">
            <span style="width:8px;height:8px;border-radius:50%;background:<%= j.warna1 %>;display:inline-block;margin-right:4px"></span>
            <%= j.nama.replace('Teknik Komputer Jaringan','TKJ').replace('Teknik Kendaraan Ringan','TKR').replace('Teknik Pemanasan, Tata Udara, dan Pendinginan','TPTUP').replace('Tata Boga','Kuliner') %>
          </button>
        <% }) %>
        <% if (tahunList.length > 1) { %>
          <span style="font-size:.82rem;font-weight:700;color:#64748b;margin-left:8px;margin-right:4px">Tahun:</span>
          <button class="idx-filter-tahun active" data-val="all"
            style="padding:5px 16px;border-radius:20px;border:2px solid #1e3a5f;background:#1e3a5f;color:#fff;font-size:.8rem;font-weight:600;cursor:pointer">Semua</button>
          <% tahunList.forEach(function(t){ %>
            <button class="idx-filter-tahun" data-val="<%= t %>"
              style="padding:5px 16px;border-radius:20px;border:2px solid #e2e8f0;background:#fff;color:#64748b;font-size:.8rem;font-weight:600;cursor:pointer;transition:all .2s">
              <%= t %>
            </button>
          <% }) %>
        <% } %>
      </div>

      <div class="row" id="proyekIndexGrid">
        <% allProyek.forEach(function(p){ %>
          <div class="col-md-6 col-lg-4 mb-4 pitem" data-jurusan="<%= p.program_slug %>" data-tahun="<%= p.tahun %>">
            <div style="background:#fff;border-radius:18px;overflow:hidden;border:1px solid #e8edf4;height:100%;transition:transform .25s,box-shadow .25s"
              onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 12px 32px rgba(0,0,0,.1)'"
              onmouseout="this.style.transform='none';this.style.boxShadow='none'">
              <!-- Foto slider 4:5 portrait dengan badge overlay -->
              <%
                var sliderFotosIdx = (p.fotos && p.fotos.length > 0)
                  ? p.fotos
                  : (p.gambar ? [{gambar: p.gambar}] : []);
                var sliderIdIdx = 'sidx_' + p.id;
              %>
              <% if (sliderFotosIdx.length > 0) { %>
                <div class="proyek-slider-idx" id="<%= sliderIdIdx %>" style="aspect-ratio:4/5;position:relative;overflow:hidden;background:#f8fafc">
                  <% sliderFotosIdx.forEach(function(f, fi){ %>
                    <div class="slide-item-idx" style="position:absolute;inset:0;transition:opacity .6s;opacity:<%= fi===0?1:0 %>;z-index:<%= fi===0?1:0 %>">
                      <img src="/uploads/<%= f.gambar %>" alt="<%= p.judul %>"
                        style="width:100%;height:100%;object-fit:cover" loading="lazy">
                    </div>
                  <% }) %>
                  <!-- Badge overlay -->
                  <div style="position:absolute;top:10px;left:10px;display:flex;gap:6px;flex-wrap:wrap;z-index:10">
                    <span style="background:<%= p.program_warna1 %>;color:#fff;padding:3px 10px;border-radius:20px;font-size:.68rem;font-weight:700"><%= p.tahun %></span>
                    <span style="background:rgba(255,255,255,.9);color:<%= p.program_warna1 %>;padding:3px 10px;border-radius:20px;font-size:.68rem;font-weight:700">
                      <%= p.program_nama.replace('Teknik Komputer Jaringan','TKJ').replace('Teknik Kendaraan Ringan','TKR').replace('Teknik Pemanasan, Tata Udara, dan Pendinginan','TPTUP').replace('Tata Boga','Kuliner') %>
                    </span>
                  </div>
                  <!-- Dots -->
                  <% if (sliderFotosIdx.length > 1) { %>
                    <div style="position:absolute;bottom:8px;left:0;right:0;display:flex;justify-content:center;gap:5px;z-index:10">
                      <% sliderFotosIdx.forEach(function(f, fi){ %>
                        <span class="dot-idx" data-idx="<%= fi %>"
                          style="width:<%= fi===0?'18px':'7px' %>;height:7px;border-radius:4px;background:rgba(255,255,255,<%= fi===0?.95:.5 %>);transition:all .3s;cursor:pointer"></span>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              <% } else { %>
                <div style="aspect-ratio:4/5;background:<%= p.program_gradient||'linear-gradient(135deg,#1e3a5f,#1a56db)' %>;display:flex;align-items:center;justify-content:center;position:relative">
                  <i class="fas fa-project-diagram" style="font-size:2.5rem;color:rgba(255,255,255,.35)"></i>
                  <div style="position:absolute;top:10px;left:10px;display:flex;gap:6px;z-index:10">
                    <span style="background:rgba(255,255,255,.2);color:#fff;padding:3px 10px;border-radius:20px;font-size:.68rem;font-weight:700"><%= p.tahun %></span>
                  </div>
                </div>
              <% } %>

              <!-- Caption detail -->
              <div style="padding:16px 18px">
                <h5 style="font-weight:700;font-size:.92rem;color:#0f172a;margin-bottom:6px;line-height:1.4"><%= p.judul %></h5>
                <% if (p.deskripsi) { %>
                  <p style="font-size:.8rem;color:#64748b;line-height:1.55;margin-bottom:8px"><%= p.deskripsi.substring(0,100) %><%= p.deskripsi.length>100?'...':'' %></p>
                <% } %>
                <div style="font-size:.76rem;color:#64748b;line-height:1.85">
                  <% if (p.tanggal_pelaksanaan) { %>
                    <div style="display:flex;gap:7px;margin-bottom:2px">
                      <span style="flex-shrink:0">📅</span>
                      <span>Pelaksanaan: <strong style="color:#475569"><%= new Date(p.tanggal_pelaksanaan).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}) %></strong></span>
                    </div>
                  <% } %>
                  <% if (p.jumlah_siswa) { %>
                    <div style="display:flex;gap:7px;margin-bottom:2px">
                      <span style="flex-shrink:0">👨‍🎓</span>
                      <span>Jumlah Siswa: <strong style="color:#475569"><%= p.jumlah_siswa %> orang</strong></span>
                    </div>
                  <% } %>
                  <% if (p.jumlah_item) { %>
                    <div style="display:flex;gap:7px;margin-bottom:2px">
                      <span style="flex-shrink:0">🔧</span>
                      <span>Jumlah: <strong style="color:#475569"><%= p.jumlah_item %> <%= p.satuan_item||'Unit' %></strong></span>
                    </div>
                  <% } %>
                  <% if (p.nama_pelanggan) { %>
                    <div style="display:flex;gap:7px;margin-bottom:2px">
                      <span style="flex-shrink:0">🏢</span>
                      <span>Pelanggan: <strong style="color:#475569"><%= p.nama_pelanggan %></strong><% if(p.kategori_pelanggan){ %> <span style="color:#94a3b8">(<%= p.kategori_pelanggan %>)</span><% } %></span>
                    </div>
                  <% } %>
                  <% if (p.lokasi) { %>
                    <div style="display:flex;gap:7px;margin-bottom:2px">
                      <span style="flex-shrink:0">📍</span>
                      <span style="color:#475569"><%= p.lokasi %></span>
                    </div>
                  <% } %>
                </div>
                <% if (p.link_maps || p.link_publikasi || p.link_tiktok || p.link_youtube || p.link_facebook || p.link_twitter || p.link_threads) { %>
                  <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;padding-top:10px;border-top:1px solid #f1f5f9">
                    <% if (p.link_maps) { %>
                      <a href="<%= p.link_maps %>" target="_blank" rel="noopener"
                        style="display:inline-flex;align-items:center;gap:5px;background:#fee2e2;color:#dc2626;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none">
                        <i class="fas fa-map-marker-alt"></i> Lokasi
                      </a>
                    <% } %>
                    <% if (p.link_publikasi) { %>
                      <a href="<%= p.link_publikasi %>" target="_blank" rel="noopener"
                        style="display:inline-flex;align-items:center;gap:5px;background:#fce7f3;color:#db2777;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none">
                        <i class="fab fa-instagram"></i> IG
                      </a>
                    <% } %>
                    <% if (p.link_tiktok) { %>
                      <a href="<%= p.link_tiktok %>" target="_blank" rel="noopener"
                        style="display:inline-flex;align-items:center;gap:5px;background:#f1f5f9;color:#0f172a;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none">
                        <i class="fab fa-tiktok"></i> TikTok
                      </a>
                    <% } %>
                    <% if (p.link_youtube) { %>
                      <a href="<%= p.link_youtube %>" target="_blank" rel="noopener"
                        style="display:inline-flex;align-items:center;gap:5px;background:#fee2e2;color:#ff0000;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none">
                        <i class="fab fa-youtube"></i> YT
                      </a>
                    <% } %>
                    <% if (p.link_facebook) { %>
                      <a href="<%= p.link_facebook %>" target="_blank" rel="noopener"
                        style="display:inline-flex;align-items:center;gap:5px;background:#eff6ff;color:#1877f2;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none">
                        <i class="fab fa-facebook"></i> FB
                      </a>
                    <% } %>
                    <% if (p.link_twitter) { %>
                      <a href="<%= p.link_twitter %>" target="_blank" rel="noopener"
                        style="display:inline-flex;align-items:center;gap:5px;background:#e7f3fd;color:#1da1f2;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none">
                        <i class="fab fa-twitter"></i> Twitter
                      </a>
                    <% } %>
                    <% if (p.link_threads) { %>
                      <a href="<%= p.link_threads %>" target="_blank" rel="noopener"
                        style="display:inline-flex;align-items:center;gap:5px;background:#f1f5f9;color:#0f172a;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none">
                        <i class="fas fa-at"></i> Threads
                      </a>
                    <% } %>
                  </div>
                <% } %>

                <!-- Anggota tim proyek -->
                <% if (p.anggota && p.anggota.length > 0) { %>
                  <div style="margin-top:12px;padding-top:10px;border-top:1px solid #f1f5f9">
                    <p style="font-size:.68rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">Tim Siswa</p>
                    <div style="display:flex;flex-wrap:wrap;gap:5px">
                      <% p.anggota.forEach(function(a){ %>
                        <%
                          var platform = {icon:'fas fa-user', color:'#94a3b8', bg:'#f8fafc'};
                          if (a.link_publikasi) {
                            if (/instagram\.com/i.test(a.link_publikasi))  platform = {icon:'fab fa-instagram', color:'#e1306c', bg:'#fce7f3'};
                            else if (/tiktok\.com/i.test(a.link_publikasi)) platform = {icon:'fab fa-tiktok', color:'#0f172a', bg:'#f1f5f9'};
                            else if (/youtube\.com|youtu\.be/i.test(a.link_publikasi)) platform = {icon:'fab fa-youtube', color:'#ff0000', bg:'#fee2e2'};
                            else if (/facebook\.com/i.test(a.link_publikasi)) platform = {icon:'fab fa-facebook', color:'#1877f2', bg:'#eff6ff'};
                            else if (/twitter\.com|x\.com/i.test(a.link_publikasi)) platform = {icon:'fab fa-twitter', color:'#1da1f2', bg:'#e7f3fd'};
                            else if (/threads\.net/i.test(a.link_publikasi)) platform = {icon:'fas fa-at', color:'#0f172a', bg:'#f1f5f9'};
                            else if (/wa\.me|whatsapp/i.test(a.link_publikasi)) platform = {icon:'fab fa-whatsapp', color:'#25d366', bg:'#f0fdf4'};
                            else platform = {icon:'fas fa-link', color:'#64748b', bg:'#f1f5f9'};
                          }
                        %>
                        <% if (a.link_publikasi) { %>
                          <a href="<%= a.link_publikasi %>" target="_blank" rel="noopener"
                            style="display:inline-flex;align-items:center;gap:5px;background:<%= platform.bg %>;color:<%= platform.color %>;padding:4px 10px;border-radius:20px;font-size:.72rem;font-weight:600;text-decoration:none">
                            <i class="<%= platform.icon %>"></i> <%= a.nama %>
                          </a>
                        <% } else { %>
                          <span style="display:inline-flex;align-items:center;gap:5px;background:#f8fafc;color:#94a3b8;padding:4px 10px;border-radius:20px;font-size:.72rem">
                            <i class="fas fa-user"></i> <%= a.nama %>
                          </span>
                        <% } %>
                      <% }) %>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <i class="fas fa-project-diagram fa-3x mb-3 d-block" style="opacity:.2"></i>
        <p>Belum ada proyek yang didokumentasikan.</p>
      </div>
    <% } %>
  </div>
</section>

<!-- BERITA GABUNGAN SEMUA JURUSAN -->
<% if (allBerita && allBerita.length > 0) { %>
<section class="section-pad" style="background:#fff" id="berita-index">
