# ============================================================
# .gitignore — Website SMK Negeri 1 Kras
# ============================================================

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# --- Environment variables (RAHASIA, JANGAN PERNAH DI-COMMIT) ---
.env
.env.local
.env.*.local

# --- Uploads (simpan struktur folder, abaikan isi) ---
uploads/*
!uploads/.gitkeep

# --- Logs ---
logs/
*.log
pids/
*.pid
*.pid.lock

# --- Coverage / Testing output ---
coverage/
.nyc_output/

# --- OS generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDE / Editor files ---
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Kiro AI / Claude AI ---
.kiro/
.claude/

# --- Build & dist ---
dist/
build/

# --- PM2 ---
.pm2/

# --- Temporary / misc ---
*.tmp
*.temp
*.zip
*.rar
*.7z
cookies.txt
FETCH_HEAD

