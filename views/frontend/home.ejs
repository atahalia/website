    <section style="padding:5rem 0;background:linear-gradient(135deg,#f8fafc 0%,#f0f9ff 100%);position:relative;overflow:hidden;">
        <div style="position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#f59e0b,#ef4444,#ec4899,#6366f1);"></div>
        <div class="container" style="position:relative;z-index:1;">
            <div class="text-center mb-5 reveal">
                <span style="display:inline-flex;align-items:center;gap:.5rem;background:#fef3c7;color:#92400e;padding:.4rem 1.1rem;border-radius:50px;font-size:.78rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;margin-bottom:1rem;">
                    <i class="fas fa-calendar-alt"></i> Jadwal Kegiatan
                </span>
                <h2 style="font-size:2.25rem;font-weight:800;color:#1e293b;margin-bottom:.6rem;">Agenda Sekolah</h2>
                <p style="color:#64748b;font-size:1rem;max-width:520px;margin:0 auto;">Jadwal kegiatan dan acara terbaru dari sekolah kami</p>
            </div>

            <div class="row g-4">
                <% agendaHome.forEach((item, idx) => { %>
                <div class="col-lg-4 col-md-6 reveal reveal-delay-<%= idx + 1 %>">
                    <a href="/agenda/<%= item.slug %>" style="text-decoration:none;display:block;height:100%;">
                    <div style="background:white;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(245,158,11,.1);border:1px solid #fef3c7;transition:all .35s ease;height:100%;" onmouseover="this.style.transform='translateY(-8px)';this.style.boxShadow='0 20px 40px rgba(245,158,11,.2)';this.style.borderColor='#fde68a'" onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 20px rgba(245,158,11,.1)';this.style.borderColor='#fef3c7'">
                        <div class="agenda-card-media" style="height:210px;">
                            <img src="<%= item.gambar ? '/uploads/' + item.gambar : '/assets/img/undraw_posting_photo.svg' %>" alt="<%= item.judul %>" loading="lazy" decoding="async" width="400" height="210">
                            <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.45) 0%,transparent 60%);"></div>
                            <div style="position:absolute;top:1rem;left:1rem;background:linear-gradient(135deg,#f59e0b,#ef4444);color:white;padding:.4rem 1rem;border-radius:50px;font-size:.78rem;font-weight:700;display:flex;align-items:center;gap:.4rem;z-index:1;">
                                <i class="fas fa-calendar-alt"></i>
                                <%= new Date(item.tanggal_mulai).toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'}) %>
                            </div>
                        </div>
                        <div style="padding:1.5rem;">
                            <h3 style="font-size:1.05rem;font-weight:700;color:#1e293b;margin-bottom:.75rem;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= item.judul %></h3>
                            <div style="display:flex;flex-direction:column;gap:.3rem;margin-bottom:1rem;">
                                <% if (item.waktu_mulai) { %>
                                <span style="font-size:.82rem;color:#64748b;display:flex;align-items:center;gap:.4rem;"><i class="fas fa-clock" style="color:#0ea5e9;width:14px;"></i> <%= item.waktu_mulai.substring(0,5) %><% if (item.waktu_selesai) { %> - <%= item.waktu_selesai.substring(0,5) %><% } else { %> - Selesai<% } %></span>
                                <% } %>
                                <% if (item.lokasi) { %>
                                <span style="font-size:.82rem;color:#64748b;display:flex;align-items:center;gap:.4rem;"><i class="fas fa-map-marker-alt" style="color:#0ea5e9;width:14px;"></i> <%= item.lokasi %></span>
                                <% } %>
                            </div>
                            <span style="display:inline-flex;align-items:center;gap:.4rem;background:#fef3c7;color:#92400e;padding:.4rem 1rem;border-radius:50px;font-size:.8rem;font-weight:700;">Lihat Detail <i class="fas fa-arrow-right"></i></span>
                        </div>
                    </div>
                    </a>
                </div>
                <% }) %>
            </div>

            <div class="text-center mt-5">
                <a href="/agenda" class="btn btn-warning btn-lg" style="border-radius:50px;padding:.85rem 2.5rem;font-weight:700;color:white;background:linear-gradient(135deg,#f59e0b,#ef4444);border:none;box-shadow:0 8px 25px rgba(245,158,11,.4);"><i class="fas fa-calendar-alt me-2"></i>Lihat Semua Agenda</a>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Artikel & File Download Section -->
    <% if ((typeof artikelHome !== 'undefined' && artikelHome && artikelHome.length > 0) || (typeof fileDownloadHome !== 'undefined' && fileDownloadHome && fileDownloadHome.length > 0)) { %>
    <section style="padding:6rem 0;background:linear-gradient(135deg,#0f0c29 0%,#1e1b4b 40%,#1a1a3e 100%);position:relative;overflow:hidden;">
        <!-- bg decorations -->
        <div style="position:absolute;top:-80px;right:-80px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(99,102,241,.25) 0%,transparent 70%);pointer-events:none;"></div>
        <div style="position:absolute;bottom:-60px;left:-60px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(14,165,233,.2) 0%,transparent 70%);pointer-events:none;"></div>
        <div style="position:absolute;top:30%;left:50%;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(236,72,153,.15) 0%,transparent 70%);pointer-events:none;"></div>
        <!-- top rainbow border -->
        <div style="position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#6366f1,#0ea5e9,#10b981,#f59e0b,#ec4899);"></div>

        <div class="container" style="position:relative;z-index:1;">
            <!-- Section header -->
            <div class="text-center mb-5 reveal">
                <span style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.9);padding:.4rem 1.1rem;border-radius:50px;font-size:.78rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;margin-bottom:1rem;backdrop-filter:blur(8px);">
                    <i class="fas fa-book-open"></i> Konten Edukatif
                </span>
                <h2 style="font-size:2.25rem;font-weight:900;color:white;margin-bottom:.5rem;">Artikel & Materi Terbaru</h2>
                <p style="color:rgba(255,255,255,.65);font-size:1rem;max-width:480px;margin:0 auto;">Tulisan edukatif dan dokumen bermanfaat dari guru dan staf sekolah</p>
            </div>

            <div class="row g-5">
                <!-- Artikel Terbaru -->
                <% if (typeof artikelHome !== 'undefined' && artikelHome && artikelHome.length > 0) { %>
                <div class="col-lg-7 reveal reveal-left">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:.75rem;">
                        <div>
                            <div style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(99,102,241,.2);border:1px solid rgba(99,102,241,.4);color:#a5b4fc;padding:.3rem .9rem;border-radius:50px;font-size:.75rem;font-weight:700;margin-bottom:.5rem;">
                                <i class="fas fa-pen-nib"></i> Artikel
                            </div>
                            <h3 style="font-size:1.5rem;font-weight:800;color:white;margin:0;">Artikel Terbaru</h3>
                            <p style="color:rgba(255,255,255,.55);font-size:.85rem;margin:.25rem 0 0;">Tulisan edukatif dari guru dan staf sekolah</p>
                        </div>
                        <a href="/artikel" style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(99,102,241,.2);border:1px solid rgba(99,102,241,.4);color:#a5b4fc;padding:.5rem 1.1rem;border-radius:50px;text-decoration:none;font-size:.82rem;font-weight:700;transition:all .2s;" onmouseover="this.style.background='rgba(99,102,241,.4)';this.style.color='white'" onmouseout="this.style.background='rgba(99,102,241,.2)';this.style.color='#a5b4fc'">Lihat Semua <i class="fas fa-arrow-right"></i></a>
                    </div>
                    <div class="row g-3">
                        <% artikelHome.forEach((item, idx) => { %>
                        <div class="col-<%= idx === 0 ? '12' : '6' %>">
                            <a href="/artikel/<%= item.slug %>" style="text-decoration:none;display:block;">
                                <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:18px;overflow:hidden;backdrop-filter:blur(8px);transition:all .3s;" onmouseover="this.style.transform='translateY(-5px)';this.style.background='rgba(255,255,255,.13)';this.style.borderColor='rgba(255,255,255,.3)'" onmouseout="this.style.transform='translateY(0)';this.style.background='rgba(255,255,255,.07)';this.style.borderColor='rgba(255,255,255,.12)'">
                                    <% if (item.gambar) { %>
                                    <div class="artikel-card-media" style="height:<%= idx === 0 ? '200px' : '130px' %>;">
                                        <img src="/uploads/<%= item.gambar %>" alt="<%= item.judul %>" loading="lazy" decoding="async" width="400" height="<%= idx === 0 ? 200 : 130 %>">
                                        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.4) 0%,transparent 60%);"></div>
                                    </div>
                                    <% } %>
                                    <div style="padding:1.25rem;">
                                        <span style="background:rgba(99,102,241,.25);color:#c7d2fe;padding:.2rem .7rem;border-radius:50px;font-size:.72rem;font-weight:700;"><%= item.kategori %></span>
                                        <h3 style="font-size:<%= idx === 0 ? '1.05rem' : '.88rem' %>;font-weight:700;color:white;margin:.65rem 0 .4rem;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= item.judul %></h3>
                                        <p style="font-size:.75rem;color:rgba(255,255,255,.5);margin:0;"><i class="fas fa-user me-1"></i><%= item.penulis_nama %> &middot; <i class="fas fa-calendar ms-1 me-1"></i><%= new Date(item.created_at).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'}) %></p>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <!-- File Download -->
                <% if (typeof fileDownloadHome !== 'undefined' && fileDownloadHome && fileDownloadHome.length > 0) { %>
                <div class="col-lg-5 reveal reveal-right">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:.75rem;">
                        <div>
                            <div style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(14,165,233,.2);border:1px solid rgba(14,165,233,.4);color:#7dd3fc;padding:.3rem .9rem;border-radius:50px;font-size:.75rem;font-weight:700;margin-bottom:.5rem;">
                                <i class="fas fa-download"></i> Unduhan
                            </div>
                            <h3 style="font-size:1.5rem;font-weight:800;color:white;margin:0;">File Download</h3>
                            <p style="color:rgba(255,255,255,.55);font-size:.85rem;margin:.25rem 0 0;">Materi dan dokumen untuk diunduh</p>
                        </div>
                        <a href="/file-download" style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(14,165,233,.2);border:1px solid rgba(14,165,233,.4);color:#7dd3fc;padding:.5rem 1.1rem;border-radius:50px;text-decoration:none;font-size:.82rem;font-weight:700;transition:all .2s;" onmouseover="this.style.background='rgba(14,165,233,.4)';this.style.color='white'" onmouseout="this.style.background='rgba(14,165,233,.2)';this.style.color='#7dd3fc'">Lihat Semua <i class="fas fa-arrow-right"></i></a>
                    </div>
                    <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:18px;overflow:hidden;backdrop-filter:blur(8px);">
                        <%
                            const tipeColorHome = { PDF:'#ef4444',DOC:'#3b82f6',DOCX:'#3b82f6',XLS:'#22c55e',XLSX:'#22c55e',PPT:'#f59e0b',PPTX:'#f59e0b',ZIP:'#6b7280',RAR:'#6b7280' };
                        %>
                        <% fileDownloadHome.forEach((item, idx) => { %>
                        <a href="/file-download/<%= item.id %>" style="display:flex;align-items:center;gap:1rem;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-bottom:<%= idx < fileDownloadHome.length - 1 ? '1px solid rgba(255,255,255,.08)' : 'none' %>;transition:background .2s;" onmouseover="this.style.background='rgba(255,255,255,.08)'" onmouseout="this.style.background='transparent'">
                            <div style="width:44px;height:44px;border-radius:12px;background:<%= tipeColorHome[item.tipe_file] || '#6366f1' %>;display:flex;align-items:center;justify-content:center;color:white;font-size:.72rem;font-weight:800;flex-shrink:0;box-shadow:0 4px 12px rgba(0,0,0,.3);">
                                <%= item.tipe_file ? item.tipe_file.substring(0,3) : 'FILE' %>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:600;color:white;font-size:.875rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= item.judul %></div>
                                <div style="font-size:.72rem;color:rgba(255,255,255,.45);margin-top:.2rem;"><%= item.kategori %> &middot; <%= item.ukuran_file %> &middot; <i class="fas fa-download me-1"></i><%= item.jumlah_download %>x</div>
                            </div>
                            <i class="fas fa-download" style="color:#7dd3fc;flex-shrink:0;font-size:.85rem;"></i>
                        </a>
                        <% }) %>
                        <div style="padding:1rem 1.25rem;border-top:1px solid rgba(255,255,255,.08);">
                            <a href="/file-download" style="display:block;text-align:center;background:linear-gradient(135deg,#0ea5e9,#6366f1);color:white;padding:.7rem;border-radius:12px;text-decoration:none;font-size:.875rem;font-weight:700;transition:opacity .2s;box-shadow:0 4px 15px rgba(14,165,233,.3);" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                                <i class="fas fa-folder-open me-2"></i>Lihat Semua File
                            </a>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- BKK Home Section -->
    <% if (typeof bkkHome !== 'undefined' && bkkHome && bkkHome.length > 0) { %>
    <section class="bkk-home-section">
        <div class="container">
            <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap gap-3">
                <div>
                    <div style="display:inline-flex;align-items:center;gap:.5rem;background:#d1fae5;color:#065f46;padding:.35rem 1rem;border-radius:50px;font-size:.8rem;font-weight:700;margin-bottom:.75rem;">
                        <i class="fas fa-briefcase"></i> BKK &middot; Bursa Kerja Khusus
                    </div>
                    <h2 style="font-size:2rem;font-weight:800;color:#1e293b;margin-bottom:.25rem;">Lowongan Terbaru</h2>
                    <p style="color:#64748b;font-size:.95rem;margin:0;">Peluang kerja, magang, dan beasiswa untuk lulusan</p>
                </div>
                <a href="/bkk" style="display:inline-flex;align-items:center;gap:.5rem;background:#10b981;color:white;padding:.65rem 1.5rem;border-radius:50px;text-decoration:none;font-weight:700;font-size:.875rem;transition:all .2s;white-space:nowrap;" onmouseover="this.style.background='#059669'" onmouseout="this.style.background='#10b981'">
                    Lihat Semua <i class="fas fa-arrow-right"></i>
                </a>
            </div>
            <div class="bkk-scroll-track" id="bkkTrack">
                <% bkkHome.forEach(function(l) { %>
                <% var isExp = l.deadline && new Date(l.deadline) < new Date(); %>
                <% var kat = l.kategori || 'lainnya'; %>
                <div class="bkk-home-card">
                    <% if (l.gambar) { %>
                    <img src="/uploads/<%= l.gambar %>" class="bkk-home-img" alt="<%= l.judul %>" loading="lazy" decoding="async" width="320" height="180">
                    <% } else { %>
                    <div class="bkk-home-placeholder"><i class="fas fa-building"></i></div>
                    <% } %>
                    <div class="bkk-home-body">
                        <span class="bkk-home-kat <%= kat %>"><%= kat.charAt(0).toUpperCase()+kat.slice(1) %></span>
                        <div class="bkk-home-title"><%= l.judul %></div>
                        <div class="bkk-home-co"><i class="fas fa-building me-1"></i><%= l.perusahaan %></div>
                        <% if (l.lokasi) { %><div class="bkk-home-loc"><i class="fas fa-map-marker-alt me-1"></i><%= l.lokasi %></div><% } %>
                        <% if (l.deadline && !isExp) { %>
                        <div style="background:#fef2f2;color:#991b1b;padding:.25rem .65rem;border-radius:8px;font-size:.7rem;font-weight:600;display:inline-flex;align-items:center;gap:.3rem;margin-bottom:.75rem;width:fit-content;">
                            <i class="fas fa-clock"></i>Deadline: <%= new Date(l.deadline).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'}) %>
                        </div>
                        <% } %>
                        <div class="bkk-home-actions">
                            <a href="/bkk/<%= l.slug %>" class="bkk-home-btn-det"><i class="fas fa-eye me-1"></i>Detail</a>
                            <% if (l.kontak && !isExp) { %>
                            <a href="<%= l.kontak.startsWith('http') ? l.kontak : 'https://wa.me/'+l.kontak.replace(/[^0-9]/g,'') %>" target="_blank" rel="noopener" class="bkk-home-btn-daf"><i class="fas fa-paper-plane me-1"></i>Daftar</a>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
            <!-- Scroll indicator dots -->
            <div style="display:flex;justify-content:center;gap:.5rem;margin-top:1.25rem;" id="bkkDots">
                <% bkkHome.forEach(function(l, i) { %>
                <div style="width:<%= i===0?'24px':'8px' %>;height:8px;border-radius:4px;background:<%= i===0?'#10b981':'#d1fae5' %>;transition:all .3s;cursor:pointer;" onclick="scrollBkk(<%= i %>)" class="bkk-dot"></div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Gallery Section -->
    <section class="gallery-section">
        <div class="container">
            <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap gap-3 reveal">
                <div>
                    <div style="display:inline-flex;align-items:center;gap:.5rem;background:#e0f2fe;color:#0369a1;padding:.35rem 1rem;border-radius:50px;font-size:.8rem;font-weight:700;margin-bottom:.75rem;">
                        <i class="fas fa-images"></i> Dokumentasi
                    </div>
                    <h2 style="font-size:2rem;font-weight:800;color:#1e293b;margin-bottom:.25rem;">Galeri Kegiatan</h2>
                    <p style="color:#64748b;font-size:.95rem;margin:0;">Momen berharga dari kegiatan dan prestasi siswa-siswi kami</p>
                </div>
                <a href="/galeri" style="display:inline-flex;align-items:center;gap:.5rem;border:2px solid #0ea5e9;color:#0ea5e9;padding:.6rem 1.4rem;border-radius:50px;text-decoration:none;font-weight:600;font-size:.875rem;transition:all .2s;white-space:nowrap;" onmouseover="this.style.background='#0ea5e9';this.style.color='white'" onmouseout="this.style.background='transparent';this.style.color='#0ea5e9'">
                    Lihat Semua <i class="fas fa-arrow-right"></i>
                </a>
            </div>
            <% if (galeri && galeri.length > 0) { %>
            <div class="gallery-masonry">
                <% galeri.slice(0, 5).forEach(function(album, idx) { %>
                <div class="g-item" onclick="window.location='/galeri'" title="<%= album.judul %>">
                    <img src="/uploads/<%= album.gambar %>" alt="<%= album.judul %>" loading="lazy" decoding="async" width="400" height="300" onerror="this.src='/assets/img/undraw_posting_photo.svg'">
                    <% if (album.jumlah > 1) { %>
                    <div class="g-count-badge"><i class="fas fa-images me-1"></i><%= album.jumlah %></div>
                    <% } %>
                    <div class="g-overlay">
                        <div>
                            <div class="g-overlay-title"><%= album.judul %></div>
                            <% if (album.jumlah > 1) { %><div class="g-overlay-count"><%= album.jumlah %> foto</div><% } %>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <div class="text-center py-5 text-muted">
                <i class="fas fa-images fa-3x mb-3 d-block" style="opacity:.3;"></i>
                <p>Belum ada foto galeri</p>
            </div>
            <% } %>
        </div>
    </section>

    <!-- Media Sosial Section -->
    <% if (mediaSosialFooter && mediaSosialFooter.length > 0) { %>
    <section class="medsos-section">
        <div class="container">
            <div class="medsos-header">
                <div>
                    <h2 class="section-title" style="color:white;text-align:left;margin-bottom:.5rem;">Ikuti Kami</h2>
                    <p style="color:rgba(255,255,255,.8);font-size:1rem;margin:0;">Update terbaru dari media sosial kami</p>
                </div>
                <div class="medsos-platforms">
                    <% const platformColors = {instagram:'#E1306C',youtube:'#FF0000',facebook:'#1877F2',tiktok:'#69C9D0',twitter:'#1DA1F2',threads:'#6366f1'}; %>
                    <% const platformIcons = {instagram:'fa-instagram',youtube:'fa-youtube',facebook:'fa-facebook-f',tiktok:'fa-tiktok',twitter:'_x_icon',threads:'_threads_icon'}; %>
                    <% const platformLabels = {instagram:'Instagram',youtube:'YouTube',facebook:'Facebook',tiktok:'TikTok',twitter:'X/Twitter',threads:'Threads'}; %>
                    <% mediaSosialFooter.forEach(function(ms) { %>
                    <a href="<%= ms.embed_url %>" target="_blank" rel="noopener" class="medsos-platform-btn" style="background:<%= platformColors[ms.platform]||'#333' %>;" title="<%= ms.judul %>">
                        <% if (ms.platform === 'twitter') { %>
                        <span style="font-weight:900;font-size:1rem;line-height:1;font-family:Arial,sans-serif;color:white;">X</span>
                        <% } else if (ms.platform === 'threads') { %>
                        <span style="font-weight:900;font-size:1.1rem;line-height:1;font-family:Arial,sans-serif;">@</span>
                        <% } else { %>
                        <i class="fab <%= platformIcons[ms.platform]||'fa-globe' %>"></i>
                        <% } %>
                    </a>
                    <% }) %>
                </div>
            </div>

            <div class="row g-4 align-items-start">
                <!-- Kiri: Post terbaru (besar) -->
                <div class="col-lg-5">
                    <% const featured = mediaSosialFooter[0]; %>
                    <div class="medsos-featured">
                        <div class="medsos-featured-badge">
                            <% if (featured.platform === 'twitter') { %><span style="font-weight:900;font-size:.9rem;font-family:Arial,sans-serif;margin-right:.3rem;color:white;">X</span>
                            <% } else if (featured.platform === 'threads') { %><span style="font-weight:900;font-size:1rem;font-family:Arial,sans-serif;margin-right:.3rem;">@</span>
                            <% } else { %><i class="fab <%= platformIcons[featured.platform]||'fa-globe' %> me-1"></i><% } %>
                            <%= featured.platform === 'twitter' ? 'X/Twitter' : featured.platform.charAt(0).toUpperCase()+featured.platform.slice(1) %>
                        </div>
                        <h3 class="medsos-featured-title"><%= featured.judul %></h3>
                        <div class="medsos-embed-wrap">
                            <%
                            const ytMatch = featured.embed_url.match(/(?:v=|youtu\.be\/)([^&\n?#]+)/);
                            const ytId = ytMatch ? ytMatch[1] : null;
                            const bgMap = {instagram:'linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045)',facebook:'linear-gradient(135deg,#1877F2,#0d5dbf)',tiktok:'linear-gradient(135deg,#010101,#69C9D0)',twitter:'linear-gradient(135deg,#000,#333)',threads:'linear-gradient(135deg,#101010,#444)'};
                            const iconMap = {instagram:'fa-instagram',facebook:'fa-facebook-f',tiktok:'fa-tiktok',twitter:'fa-twitter',threads:'fa-at'};
                            const labelMap = {instagram:'Lihat di Instagram',facebook:'Lihat di Facebook',tiktok:'Lihat di TikTok',twitter:'Lihat di X/Twitter',threads:'Lihat di Threads'};
                            %>
                            <% if (featured.platform === 'youtube' && ytId) { %>
                                <!-- YouTube: embed langsung -->
                                <div class="ratio ratio-16x9" style="border-radius:16px;overflow:hidden;">
                                    <iframe src="https://www.youtube.com/embed/<%= ytId %>?rel=0&modestbranding=1" allowfullscreen style="border:0;"></iframe>
                                </div>
                            <% } else if (featured.platform === 'instagram') { %>
                                <%
                                // Instagram iframe sudah sering diblokir browser (cookie, CSP, login-wall)
                                // Gunakan card dengan thumbnail — konsisten di semua browser & visitor
                                const igPostId = (featured.embed_url.match(/instagram\.com\/(?:p|reel|tv)\/([A-Za-z0-9_\-]+)/)||[])[1];
                                const isReel   = featured.embed_url.includes('/reel/') || featured.embed_url.includes('/tv/');
                                const igLabel  = isReel ? 'Instagram Reel' : 'Instagram Post';
                                const igIcon   = isReel ? 'fa-film' : 'fa-image';
                                %>
                                <a href="<%= featured.embed_url %>" target="_blank" rel="noopener" style="display:block;text-decoration:none;">
                                    <div style="border-radius:16px;overflow:hidden;position:relative;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);width:100%;">
                                        <% if (featured.thumbnail) { %>
                                        <img src="/uploads/<%= featured.thumbnail %>" alt="<%= featured.judul %>"
                                            style="width:100%;height:auto;display:block;border-radius:16px;aspect-ratio:1/1;object-fit:cover;"
                                            loading="lazy" decoding="async"
                                            onerror="this.style.display='none'">
                                        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.65) 0%,transparent 50%);border-radius:16px;"></div>
                                        <% } else { %>
                                        <div style="aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;">
                                            <i class="fab fa-instagram" style="font-size:5rem;color:rgba(255,255,255,.35);"></i>
                                        </div>
                                        <% } %>
                                        <!-- Center play/view button -->
                                        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:60px;height:60px;background:rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(6px);border:2px solid rgba(255,255,255,.5);">
                                            <i class="<% if(isReel){ %>fas fa-play<% } else { %>fab fa-instagram<% } %>" style="color:white;font-size:1.3rem;<% if(isReel){ %>margin-left:3px;<% } %>"></i>
                                        </div>
                                        <!-- Bottom info bar -->
                                        <div style="position:absolute;bottom:0;left:0;right:0;padding:1.1rem;z-index:1;">
                                            <div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.35rem;">
                                                <i class="fab fa-instagram" style="color:white;font-size:.85rem;"></i>
                                                <i class="fas <%= igIcon %>" style="color:rgba(255,255,255,.8);font-size:.72rem;"></i>
                                                <span style="color:rgba(255,255,255,.85);font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;"><%= igLabel %></span>
                                            </div>
                                            <div style="color:white;font-weight:700;font-size:.9rem;line-height:1.35;text-shadow:0 1px 4px rgba(0,0,0,.6);margin-bottom:.5rem;"><%= featured.judul %></div>
                                            <div style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.2);color:white;padding:.3rem .9rem;border-radius:50px;font-size:.75rem;font-weight:600;border:1px solid rgba(255,255,255,.35);">
                                                <i class="fas fa-external-link-alt" style="font-size:.65rem;"></i> Lihat di Instagram
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            <% } else { %>
                                <!-- Non-YouTube non-Instagram: card dengan thumbnail -->
                                <%
                                const bg = bgMap[featured.platform] || 'linear-gradient(135deg,#334155,#1e293b)';
                                const icon = iconMap[featured.platform] || 'fa-globe';
                                const label = labelMap[featured.platform] || 'Lihat Postingan';
                                const thumbSrc = featured.thumbnail ? '/uploads/' + featured.thumbnail : null;
                                %>
                                <a href="<%= featured.embed_url %>" target="_blank" rel="noopener" style="display:block;text-decoration:none;">
                                    <div style="background:<%= bg %>;border-radius:16px;overflow:hidden;position:relative;width:100%;">
                                        <% if (thumbSrc) { %>
                                        <img src="<%= thumbSrc %>" alt="<%= featured.judul %>" style="width:100%;height:auto;display:block;border-radius:16px;" loading="lazy" decoding="async" onerror="this.style.display='none'">
                                        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.6) 0%,transparent 40%);border-radius:16px;"></div>
                                        <% } else { %>
                                        <div style="aspect-ratio:1/1;"></div>
                                        <% } %>
                                        <!-- Center icon -->
                                        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:56px;height:56px;background:rgba(255,255,255,.22);border-radius:50%;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);border:2px solid rgba(255,255,255,.45);">
                                            <i class="fab <%= icon %>" style="color:white;font-size:1.4rem;"></i>
                                        </div>
                                        <!-- Bottom label -->
                                        <div style="position:absolute;bottom:0;left:0;right:0;padding:1.1rem;z-index:1;">
                                            <div style="color:white;font-weight:700;font-size:.9rem;line-height:1.35;text-shadow:0 1px 4px rgba(0,0,0,.6);margin-bottom:.4rem;"><%= featured.judul %></div>
                                            <div style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.2);color:white;padding:.3rem .9rem;border-radius:50px;font-size:.75rem;font-weight:600;border:1px solid rgba(255,255,255,.3);">
                                                <i class="fas fa-external-link-alt" style="font-size:.65rem;"></i><%= label %>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            <% } %>
                        </div>
                        <a href="<%= featured.embed_url %>" target="_blank" rel="noopener" class="medsos-featured-link">
                            <i class="fas fa-external-link-alt me-2"></i>Buka di <%= featured.platform.charAt(0).toUpperCase()+featured.platform.slice(1) %>
                        </a>
                    </div>
                </div>

                <!-- Kanan: Post lainnya (kecil) -->
                <div class="col-lg-7">
                    <div class="medsos-list">
                        <% mediaSosialFooter.slice(1, 6).forEach(function(ms, idx) { %>
                        <a href="<%= ms.embed_url %>" target="_blank" rel="noopener" class="medsos-list-item">
                            <div class="medsos-list-icon" style="background:<%= platformColors[ms.platform]||'#333' %>;">
                                <% if (ms.platform === 'twitter') { %>
                                <span style="font-weight:900;font-size:1rem;color:white;font-family:Arial,sans-serif;">X</span>
                                <% } else if (ms.platform === 'threads') { %>
                                <span style="font-weight:900;font-size:1.2rem;color:white;font-family:Arial,sans-serif;">@</span>
                                <% } else { %>
                                <i class="fab <%= platformIcons[ms.platform]||'fa-globe' %>"></i>
                                <% } %>
                            </div>
                            <div class="medsos-list-content">
                                <div class="medsos-list-platform"><%= ms.platform.charAt(0).toUpperCase()+ms.platform.slice(1) %></div>
                                <div class="medsos-list-title"><%= ms.judul %></div>
                            </div>
                            <div class="medsos-list-arrow"><i class="fas fa-arrow-right"></i></div>
                        </a>
                        <% }) %>

                        <!-- Ajakan follow -->
                        <div class="medsos-follow-cta">
                            <div style="font-size:1.1rem;font-weight:700;color:white;margin-bottom:.5rem;">
                                <i class="fas fa-bell me-2" style="color:#fbbf24;"></i>Jangan Lewatkan Update Kami!
                            </div>
                            <p style="color:rgba(255,255,255,.75);font-size:.9rem;margin-bottom:1rem;">Follow semua akun media sosial kami untuk mendapatkan informasi terbaru seputar kegiatan sekolah.</p>
                            <a href="/media-sosial" class="btn btn-light btn-sm" style="border-radius:50px;font-weight:700;color:var(--primary-blue);">
                                <i class="fas fa-share-alt me-2"></i>Lihat Semua Media Sosial
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SECTION: GURU & STAFF                                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <% if (guruHome && guruHome.length > 0) { %>
    <section id="section-guru">
        <!-- Background dekor -->
        <div class="guru-bg-decor">
            <div class="guru-orb guru-orb-1"></div>
            <div class="guru-orb guru-orb-2"></div>
            <div class="guru-orb guru-orb-3"></div>
            <div class="guru-grid-overlay"></div>
        </div>
        <div class="container" style="position:relative;z-index:1;">
            <div class="text-center mb-4">
                <span class="guru-eyebrow"><i class="fas fa-chalkboard-teacher me-2"></i>Tenaga Pendidik</span>
                <h2 class="guru-section-title">Guru &amp; <span class="guru-title-accent">Staff</span></h2>
                <p class="guru-section-sub">Tenaga pendidik dan kependidikan SMK Negeri 1 Kras</p>
                <div class="guru-title-line"></div>
            </div>

            <!-- Slider wrapper -->
            <div class="guru-slider-outer" style="position:relative;">
                <!-- Track -->
                <div class="guru-slider-track" id="guruTrack">
                <%
                    // Kelompokkan berdasarkan urutan_jabatan agar label bisa ditampilkan
                    const jabatanLabel = {
                        1: 'Kepala Sekolah', 2: 'Wakil Kepala Sekolah',
                        3: 'Kepala Tata Usaha', 4: 'Kepala Kompetensi Keahlian',
                        5: 'Guru', 6: 'Staff / Karyawan', 7: 'Lainnya'
                    };
                    // Bagi guru ke halaman (6 per slide)
                    const perSlide = 6;
                    const totalSlides = Math.ceil(guruHome.length / perSlide);
                    for (let s = 0; s < totalSlides; s++) {
                        const batch = guruHome.slice(s * perSlide, (s + 1) * perSlide);
                %>
                <div class="guru-slide <%= s === 0 ? 'active' : '' %>" data-slide="<%= s %>">
                    <div class="row g-3 justify-content-center">
                    <% batch.forEach(function(g) {
                        const jabNum = g.urutan_jabatan;
                        const labelJab = jabatanLabel[jabNum] || g.jabatan || 'Guru';
                        const badgeColor = jabNum === 1 ? '#dc2626' : jabNum === 2 ? '#2563eb' : jabNum === 3 ? '#7c3aed' : jabNum === 4 ? '#0891b2' : jabNum === 5 ? '#16a34a' : '#64748b';
                    %>
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6">
                        <% const glowColor = jabNum === 1 ? 'rgba(220,38,38,.35)' : jabNum === 2 ? 'rgba(37,99,235,.35)' : jabNum === 3 ? 'rgba(124,58,237,.35)' : jabNum === 4 ? 'rgba(8,145,178,.35)' : jabNum === 5 ? 'rgba(22,163,74,.35)' : 'rgba(99,102,241,.3)'; %>
                        <div class="guru-card" style="--glow:<%- glowColor %>;">
                            <div class="guru-foto-wrap">
                                <% if (g.foto) { %>
                                <img src="/uploads/<%= g.foto %>" alt="<%= g.nama %>" class="guru-foto" loading="lazy" decoding="async" width="200" height="200" onerror="this.src='/assets/img/undraw_profile.svg'">
                                <% } else { %>
                                <div class="guru-foto-placeholder">
                                    <i class="fas fa-user-tie"></i>
                                </div>
                                <% } %>
                                <div class="guru-foto-overlay"></div>
                            </div>
                            <span class="guru-badge" style="background:<%= badgeColor %>;">
                                <%= jabNum === 1 ? 'Kepsek' : jabNum === 2 ? 'Waka' : jabNum === 3 ? 'KTU' : jabNum === 4 ? 'Kakomli' : jabNum === 5 ? 'Guru' : 'Staff' %>
                            </span>
                            <div class="guru-info">
                                <div class="guru-nama"><%= g.nama %></div>
                                <div class="guru-jabatan"><%= g.jabatan || labelJab %></div>
                                <% if (g.mata_pelajaran) { %>
                                <div class="guru-mapel"><%= g.mata_pelajaran %></div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                    </div>
                </div>
                <% } %>
                </div><!-- /track -->

                <!-- Prev/Next -->
                <% if (totalSlides > 1) { %>
                <button class="guru-arrow guru-prev" onclick="guruSlide(-1)" aria-label="Sebelumnya">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="guru-arrow guru-next" onclick="guruSlide(1)" aria-label="Berikutnya">
                    <i class="fas fa-chevron-right"></i>
                </button>
                <% } %>
            </div><!-- /outer -->

            <!-- Dots + counter -->
            <% if (totalSlides > 1) { %>
            <div class="guru-dots" id="guruDots">
                <% for (let d = 0; d < totalSlides; d++) { %>
                <button class="guru-dot <%= d === 0 ? 'active' : '' %>" onclick="guruGoTo(<%= d %>)" aria-label="Slide <%= d+1 %>"></button>
                <% } %>
            </div>
            <div style="text-align:center;margin-top:.75rem;">
                <span id="guruCounter" style="font-size:.8rem;color:rgba(255,255,255,.5);">1 / <%= totalSlides %></span>
            </div>
            <% } %>

            <div style="text-align:center;margin-top:2.5rem;">
                <a href="/guru" class="guru-cta-btn">
                    <i class="fas fa-users me-2"></i>Lihat Semua Guru &amp; Staff
                </a>
            </div>
        </div>
    </section>

    <style>
    /* ══════════════════════════════════════════
       SECTION GURU — Modern Dark Gradient
    ══════════════════════════════════════════ */
    #section-guru {
        position: relative;
        padding: 5.5rem 0 4.5rem;
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 35%, #0c2340 65%, #0f172a 100%);
        overflow: hidden;
    }

    /* Background dekor */
    .guru-bg-decor {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }
    .guru-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: .35;
    }
    .guru-orb-1 {
        width: 500px; height: 500px;
        background: radial-gradient(circle, #6366f1 0%, transparent 70%);
        top: -150px; left: -100px;
        animation: guruOrbFloat 18s ease-in-out infinite;
    }
    .guru-orb-2 {
        width: 400px; height: 400px;
        background: radial-gradient(circle, #0ea5e9 0%, transparent 70%);
        bottom: -100px; right: -80px;
        animation: guruOrbFloat 14s ease-in-out 4s infinite reverse;
    }
    .guru-orb-3 {
        width: 280px; height: 280px;
        background: radial-gradient(circle, #10b981 0%, transparent 70%);
        top: 40%; left: 55%;
        animation: guruOrbFloat 20s ease-in-out 8s infinite;
        opacity: .2;
    }
    @keyframes guruOrbFloat {
        0%,100% { transform: translateY(0) scale(1); }
        50%      { transform: translateY(-30px) scale(1.08); }
    }
    .guru-grid-overlay {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
        background-size: 50px 50px;
    }

    /* Header */
    .guru-eyebrow {
        display: inline-flex;
        align-items: center;
        background: rgba(99,102,241,.18);
        border: 1px solid rgba(99,102,241,.35);
        color: #a5b4fc;
        padding: .4rem 1.2rem;
        border-radius: 50px;
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }
    .guru-section-title {
        font-size: clamp(1.9rem, 4vw, 2.8rem);
        font-weight: 900;
        color: white;
        margin-bottom: .5rem;
        line-height: 1.15;
    }
    .guru-title-accent {
        background: linear-gradient(135deg, #6366f1, #0ea5e9, #10b981);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .guru-section-sub {
        color: rgba(255,255,255,.55);
        font-size: .98rem;
        margin-bottom: .8rem;
    }
    .guru-title-line {
        width: 60px;
        height: 3px;
        background: linear-gradient(90deg, #6366f1, #0ea5e9);
        border-radius: 2px;
        margin: 0 auto;
    }

    /* Card */
    .guru-card {
        background: rgba(255,255,255,.06);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 18px;
        overflow: visible;
        transition: all .35s cubic-bezier(.22,.68,0,1.2);
        text-align: center;
        height: 100%;
        position: relative;
    }
    .guru-card:hover {
        transform: translateY(-8px) scale(1.02);
        background: rgba(255,255,255,.1);
        border-color: rgba(255,255,255,.25);
        box-shadow: 0 20px 50px var(--glow, rgba(99,102,241,.3));
    }

    /* Foto */
    .guru-foto-wrap {
        position: relative;
        padding-top: 133%;   /* rasio 3:4 — cocok untuk foto portrait/formal guru */
        border-radius: 18px 18px 0 0;
        overflow: hidden;
        background: linear-gradient(135deg, #1e1b4b, #0c2340);
    }
    .guru-foto {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;  /* center horizontal, mulai dari atas agar wajah tidak terpotong */
        transition: transform .4s ease;
    }
    .guru-card:hover .guru-foto { transform: scale(1.06); }
    .guru-foto-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(15,23,42,.7) 0%, transparent 50%);
    }
    .guru-foto-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3.5rem;   /* lebih besar karena kotak lebih tinggi */
        color: rgba(255,255,255,.2);
        background: linear-gradient(135deg, #1e1b4b 0%, #0c2340 100%);
    }

    /* Badge jabatan */
    .guru-badge {
        display: inline-block;
        margin: -.6rem auto .4rem;
        position: relative;
        z-index: 2;
        color: white;
        font-size: .58rem;
        font-weight: 800;
        padding: .25rem .7rem;
        border-radius: 20px;
        white-space: nowrap;
        letter-spacing: .06em;
        text-transform: uppercase;
        box-shadow: 0 4px 12px rgba(0,0,0,.4);
    }

    /* Info */
    .guru-info { padding: .5rem .6rem .9rem; }
    .guru-nama {
        font-size: .76rem;
        font-weight: 700;
        color: white;
        line-height: 1.35;
        margin-bottom: .2rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .guru-jabatan {
        font-size: .65rem;
        color: rgba(255,255,255,.5);
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .guru-mapel {
        font-size: .62rem;
        color: #7dd3fc;
        margin-top: .25rem;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Slide transition */
    .guru-slider-outer { overflow: hidden; }
    .guru-slider-track { position: relative; }
    .guru-slide {
        display: none;
        animation: guruFadeIn .5s cubic-bezier(.22,.68,0,1.1);
    }
    .guru-slide.active { display: block; }
    @keyframes guruFadeIn {
        from { opacity: 0; transform: translateX(40px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    /* Arrows */
    .guru-arrow {
        position: absolute;
        top: 50%; transform: translateY(-50%);
        z-index: 5;
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.15);
        width: 42px; height: 42px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: .9rem;
        color: rgba(255,255,255,.7);
        cursor: pointer;
        transition: all .25s;
    }
    .guru-arrow:hover {
        background: linear-gradient(135deg, #6366f1, #0ea5e9);
        border-color: transparent;
        color: white;
        box-shadow: 0 6px 20px rgba(99,102,241,.5);
        transform: translateY(-50%) scale(1.1);
    }
    .guru-prev { left: -5px; }
    .guru-next { right: -5px; }
    @media(max-width:768px){ .guru-prev{left:0;} .guru-next{right:0;} }

    /* Dots */
    .guru-dots {
        display: flex; justify-content: center; gap: .45rem;
        margin-top: 1.75rem;
    }
    .guru-dot {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: rgba(255,255,255,.2);
        border: none; cursor: pointer;
        transition: all .3s;
        padding: 0;
    }
    .guru-dot.active {
        background: linear-gradient(90deg, #6366f1, #0ea5e9);
        width: 28px;
        border-radius: 4px;
    }

    /* CTA button */
    .guru-cta-btn {
        display: inline-flex;
        align-items: center;
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.2);
        color: white;
        font-weight: 700;
        font-size: .95rem;
        padding: .85rem 2rem;
        border-radius: 50px;
        text-decoration: none;
        transition: all .3s;
        letter-spacing: .02em;
    }
    .guru-cta-btn:hover {
        background: linear-gradient(135deg, #6366f1, #0ea5e9);
        border-color: transparent;
        color: white;
        text-decoration: none;
        transform: translateY(-3px);
        box-shadow: 0 12px 35px rgba(99,102,241,.45);
    }
    </style>

    <script>
    (function(){
        let guruCurrent = 0;
        const slides = document.querySelectorAll('.guru-slide');
        const dots   = document.querySelectorAll('.guru-dot');
        const counter = document.getElementById('guruCounter');
        const total  = slides.length;
        if (!total) return;

        window.guruGoTo = function(n) {
            slides[guruCurrent].classList.remove('active');
            dots[guruCurrent] && dots[guruCurrent].classList.remove('active');
            guruCurrent = (n + total) % total;
            slides[guruCurrent].classList.add('active');
            dots[guruCurrent] && dots[guruCurrent].classList.add('active');
            if (counter) counter.textContent = (guruCurrent + 1) + ' / ' + total;
        };
        window.guruSlide = function(dir) { guruGoTo(guruCurrent + dir); };

        // Auto-slide setiap 10 detik
        let timer = setInterval(function(){ guruGoTo(guruCurrent + 1); }, 10000);

        // Pause saat hover
        const outer = document.getElementById('guruTrack');
        if (outer) {
            outer.addEventListener('mouseenter', function(){ clearInterval(timer); });
            outer.addEventListener('mouseleave', function(){
                clearInterval(timer);
                timer = setInterval(function(){ guruGoTo(guruCurrent + 1); }, 10000);
            });
        }
    })();
    </script>
    <% } %>

