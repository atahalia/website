<script>
  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach(function(el){
    el.addEventListener('click', function(e){
      var target = document.querySelector(this.getAttribute('href'));
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior:'smooth', block:'start' }); }
    });
  });
</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV/XN/WLEo=" crossorigin=""></script>
<script>
// ── Filter Proyek ─────────────────────────────────────────────────────
document.querySelectorAll('.proyek-filter').forEach(function(btn){
  btn.addEventListener('click', function(){
    var tahun = this.dataset.tahun;
    // Update active style
    document.querySelectorAll('.proyek-filter').forEach(function(b){
      b.style.background = '#fff'; b.style.color = '#64748b'; b.style.borderColor = '#e2e8f0';
      b.classList.remove('active');
    });
    this.style.background = 'var(--move-primary)'; this.style.color = '#fff'; this.style.borderColor = 'var(--move-primary)';
    this.classList.add('active');
    // Filter tampilan
    document.querySelectorAll('.proyek-item').forEach(function(item){
      item.style.display = (tahun === 'all' || item.dataset.tahun == tahun) ? '' : 'none';
    });
  });
});

// ── Peta Leaflet ─────────────────────────────────────────────────────
if (document.getElementById('moveMap')) {
  var mapEl = document.getElementById('moveMap');
  var moveMap = L.map('moveMap').setView([-7.822, 112.012], 12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '© <a href="https://openstreetmap.org">OpenStreetMap</a> contributors'
  }).addTo(moveMap);

  function makePin(color) {
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="38" viewBox="0 0 28 38">'
      + '<ellipse cx="14" cy="35" rx="5" ry="2" fill="rgba(0,0,0,0.15)"/>'
      + '<path d="M14 0C8.477 0 4 4.477 4 10c0 7.5 10 24 10 24S24 17.5 24 10C24 4.477 19.523 0 14 0z" fill="' + color + '" stroke="rgba(0,0,0,.15)" stroke-width="0.5"/>'
      + '<circle cx="14" cy="10" r="5" fill="white" opacity="0.9"/>'
      + '</svg>';
    return L.divIcon({ html: svg, iconSize:[28,38], iconAnchor:[14,38], popupAnchor:[0,-36], className:'' });
  }

  fetch('/api/move/pelanggan')
    .then(function(r){ return r.json(); })
    .then(function(data){
      if (!data.length) {
        mapEl.style.background = '#f8fafc';
        mapEl.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#94a3b8"><i class="fas fa-map-marker-alt" style="font-size:3rem;margin-bottom:12px;opacity:.3"></i><p style="font-size:.9rem">Belum ada data lokasi pelanggan</p></div>';
        return;
      }
      var bounds = [];
      data.forEach(function(k){
        var icon = makePin(k.warna1 || '#4e73df');
        var googleUrl = 'https://www.google.com/maps?q=' + k.lat + ',' + k.lng;
        var popup = '<div style="min-width:200px;font-family:Inter,sans-serif">'
          + '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">'
          + '<span style="width:10px;height:10px;border-radius:50%;background:' + (k.warna1||'#4e73df') + ';display:inline-block;flex-shrink:0"></span>'
          + '<span style="font-size:.72rem;font-weight:700;color:' + (k.warna1||'#4e73df') + '">' + k.program_nama + '</span>'
          + '</div>'
          + '<strong style="font-size:.92rem;color:#0f172a;line-height:1.4;display:block;margin-bottom:6px">' + k.nama + '</strong>'
          + (k.alamat ? '<div style="font-size:.78rem;color:#64748b;margin-bottom:4px"><i style="margin-right:4px"></i>' + k.alamat + '</div>' : '')
          + (k.layanan ? '<div style="font-size:.78rem;color:#64748b;margin-bottom:4px">Layanan: <strong>' + k.layanan + '</strong></div>' : '')
          + '<div style="font-size:.75rem;color:#94a3b8;margin-bottom:10px">Tahun ' + k.tahun + '</div>'
          + '<a href="' + googleUrl + '" target="_blank" style="display:inline-flex;align-items:center;gap:6px;background:#1a56db;color:#fff;padding:6px 14px;border-radius:20px;font-size:.75rem;font-weight:600;text-decoration:none">'
          + '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M14 3v2H7v14h14v-7h2v9H5V3h9zm5 0h4v4h-2V6.414l-9.293 9.293-1.414-1.414L19.586 5H17V3z"/></svg>'
          + 'Buka di Google Maps</a>'
          + '</div>';
        var marker = L.marker([k.lat, k.lng], { icon: icon }).addTo(moveMap).bindPopup(popup, { maxWidth: 240 });
        bounds.push([k.lat, k.lng]);
      });
      if (bounds.length) moveMap.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
    })
    .catch(function(){ console.warn('Gagal memuat data peta'); });
}
</script>
</body>
</html>
