        d.setUTCDate(d.getUTCDate() + 4 - dayNum);
        var yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
        return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
      }

      function getStorageKey() {
        var now = new Date();
        return 'jp_senin_upacara_' + now.getFullYear() + '_w' + getNomorMinggu(now);
      }

      // Default: ada upacara (true)
      function isUpacara() {
        var val = localStorage.getItem(getStorageKey());
        return val === null ? true : val === '1';
      }

      // Toggle dan simpan
      window.jpToggleSenin = function() {
        var cur = isUpacara();
        localStorage.setItem(getStorageKey(), cur ? '0' : '1');
        updateToggleBtn();
      };

      function updateToggleBtn() {
        var btn = document.getElementById('jp-btn-toggle');
        var lbl = document.getElementById('jp-toggle-label');
        if (!btn || !lbl) return;
        if (isUpacara()) {
          lbl.textContent = 'Ada Upacara';
          btn.style.background = 'rgba(251,191,36,.25)';
          btn.style.borderColor = 'rgba(251,191,36,.6)';
          btn.style.color = '#fde68a';
        } else {
          lbl.textContent = 'Tanpa Upacara';
          btn.style.background = 'rgba(74,222,128,.2)';
          btn.style.borderColor = 'rgba(74,222,128,.5)';
          btn.style.color = '#bbf7d0';
        }
      }

      function pad(n) { return String(Math.max(0,Math.floor(n))).padStart(2,'0'); }
      function menitKeStr(m) { return pad(m/60) + ':' + pad(m%60); }

      function tick() {
        var now  = new Date();
        var hari = now.getDay();
        var menitNow = now.getHours()*60 + now.getMinutes();
        var totalSec = now.getHours()*3600 + now.getMinutes()*60 + now.getSeconds();

        document.getElementById('jp-jam-sekarang').textContent =
          pad(now.getHours())+':'+pad(now.getMinutes())+':'+pad(now.getSeconds());

        var hariLabel = NAMA_HARI[hari];
        var toggleEl  = document.getElementById('jp-senin-toggle');
        var jadwal;

        if (hari === 1) {
          // Senin — tampilkan toggle
          toggleEl.style.display = 'block';
          updateToggleBtn();
          jadwal = JADWAL[isUpacara() ? '1_upacara' : '1_biasa'];
          hariLabel = isUpacara() ? 'Senin (Upacara)' : 'Senin (Tanpa Upacara)';
        } else {
          toggleEl.style.display = 'none';
          jadwal = JADWAL[hari];
        }

        document.getElementById('jp-hari-label').textContent = hariLabel;

        var statusEl = document.getElementById('jp-status-text');
        var detailEl = document.getElementById('jp-detail-text');
        var cdEl     = document.getElementById('jp-countdown');
        var progEl   = document.getElementById('jp-progress');
        var banner   = document.getElementById('jam-pelajaran-banner');

        if (!jadwal) {
          statusEl.textContent = '\uD83C\uDF89 Hari Libur';
          detailEl.textContent = 'Selamat beristirahat!';
          cdEl.textContent     = '--:--';
          progEl.style.width   = '0%';
          statusEl.style.color = '#4ade80';
          banner.style.background = 'linear-gradient(135deg,#1e3a5f 0%,#1a56db 100%)';
          return;
        }

        var slot = null, next = null;
        for (var i = 0; i < jadwal.length; i++) {
          if (menitNow >= jadwal[i].mulai && menitNow < jadwal[i].akhir) {
            slot = jadwal[i];
            if (i+1 < jadwal.length) next = jadwal[i+1];
            break;
          }
          if (menitNow < jadwal[i].mulai && !next) next = jadwal[i];
        }

        if (slot) {
          var durasi   = slot.akhir - slot.mulai;
          var terlewat = menitNow - slot.mulai + now.getSeconds()/60;
          var sisaSec  = slot.akhir*60 - totalSec;
          var pct      = Math.min(100, (terlewat/durasi)*100);

          statusEl.style.color  = slot.istirahat ? '#4ade80' : '#fbbf24';
          statusEl.textContent  = (slot.istirahat ? '\u2615 ' : '\uD83D\uDCDA ') + slot.label;
          detailEl.textContent  = menitKeStr(slot.mulai) + ' \u2013 ' + menitKeStr(slot.akhir) +
            (next ? '  |  Berikutnya: ' + next.label + ' pukul ' + menitKeStr(next.mulai) : '');
          cdEl.textContent      = pad(sisaSec/60) + ':' + pad(sisaSec%60);
          progEl.style.width    = pct + '%';
          banner.style.background = slot.istirahat
            ? 'linear-gradient(135deg,#065f46 0%,#059669 100%)'
            : 'linear-gradient(135deg,#1e3a5f 0%,#1a56db 100%)';

        } else {
          var first = jadwal[0], last = jadwal[jadwal.length-1];
          banner.style.background = 'linear-gradient(135deg,#1e3a5f 0%,#1a56db 100%)';
          if (menitNow < first.mulai) {
            var sisaMulai = first.mulai*60 - totalSec;
            statusEl.style.color = '#93c5fd';
            statusEl.textContent = '\uD83C\uDF05 Belum mulai';
            detailEl.textContent = 'KBM dimulai pukul ' + menitKeStr(first.mulai);
            cdEl.textContent     = pad(sisaMulai/60) + ':' + pad(sisaMulai%60);
            progEl.style.width   = '0%';
          } else {
            statusEl.style.color = '#a3e635';
            statusEl.textContent = '\uD83C\uDFC1 KBM Selesai';
            detailEl.textContent = 'Jam pelajaran berakhir pukul ' + menitKeStr(last.akhir);
            cdEl.textContent     = '00:00';
            progEl.style.width   = '100%';
          }
        }
      }

      tick();
      setInterval(tick, 1000);
    })();
    </script>
    <!-- ===== END BANNER JAM PELAJARAN ===== -->


