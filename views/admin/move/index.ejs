<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title><%= title %> - Admin Panel</title>
  <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
  <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
  <style>
    .move-card { border-radius: 16px; overflow: hidden; transition: transform .2s, box-shadow .2s; }
    .move-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,.12) !important; }
    .move-card-header { padding: 24px; color: #fff; position: relative; }
    .move-card-header .badge-free { position: absolute; top: 16px; right: 16px; background: rgba(255,255,255,.2); color: #fff; padding: 4px 12px; border-radius: 20px; font-size: .72rem; font-weight: 700; }
    .stat-pill { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.15); border-radius: 20px; padding: 4px 12px; font-size: .78rem; color: #fff; margin-right: 6px; margin-top: 8px; }
    .action-btn { border-radius: 8px; padding: 6px 14px; font-size: .82rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; border: none; cursor: pointer; text-decoration: none; }
    .action-btn:hover { opacity: .85; }
  </style>
</head>
<body id="page-top">
<div id="wrapper">
  <%- include('../partials/sidebar') %>
  <div id="content-wrapper" class="d-flex flex-column">
    <div id="content">
      <%- include('../partials/topbar', { user }) %>
      <div class="container-fluid">

        <!-- Page header -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
          <div>
            <h1 class="h3 mb-0 text-gray-800">
              <i class="fas fa-hands-helping text-primary mr-2"></i>Program MOVE
            </h1>
            <p class="text-muted mb-0" style="font-size:.88rem">Melayani Komunitas Via Edukasi — kelola konten landing page per jurusan</p>
          </div>
          <a href="/move" target="_blank" class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm">
            <i class="fas fa-external-link-alt fa-sm mr-1"></i> Lihat Landing Page
          </a>
        </div>

        <% if (success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i> Berhasil disimpan!
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle mr-2"></i> <%= error %>
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
        <% } %>

        <!-- Info banner -->
        <div class="alert alert-info border-left-info mb-4" style="border-radius:12px">
          <i class="fas fa-info-circle mr-2"></i>
          <strong>Cara penggunaan:</strong> Klik <strong>Edit</strong> pada jurusan untuk mengubah informasi utama.
          Gunakan tombol <strong>Layanan</strong>, <strong>Galeri</strong>, <strong>Sosmed</strong>, dan <strong>Tim</strong> untuk mengelola konten masing-masing bagian.
        </div>

        <!-- Program cards -->
        <div class="row">
          <% programs.forEach(function(p){ %>
            <div class="col-xl-6 col-lg-6 mb-4">
              <div class="card shadow move-card">
                <!-- Header berwarna sesuai jurusan -->
                <div class="move-card-header" style="background: <%= p.gradient %>">
                  <span class="badge-free">GRATIS</span>
                  <div class="d-flex align-items-center">
                    <div style="width:52px;height:52px;border-radius:14px;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin-right:16px;flex-shrink:0">
                      <i class="<%= p.icon %>"></i>
                    </div>
                    <div>
                      <h5 class="mb-1 font-weight-bold"><%= p.nama %></h5>
                      <span class="badge <%= p.status === 'aktif' ? 'badge-success' : 'badge-secondary' %>" style="font-size:.72rem">
                        <%= p.status === 'aktif' ? '● Aktif' : '○ Nonaktif' %>
                      </span>
                    </div>
                  </div>
                  <div class="mt-2">
                    <span class="stat-pill"><i class="fas fa-layer-group"></i> <%= p.jml_layanan %> Layanan</span>
                    <span class="stat-pill"><i class="fas fa-images"></i> <%= p.jml_galeri %> Foto</span>
                    <span class="stat-pill"><i class="fas fa-users"></i> <%= p.jml_pengelola %> Tim</span>
                  </div>
                </div>

                <!-- Body aksi -->
                <div class="card-body" style="padding:20px">
                  <p class="text-muted mb-3" style="font-size:.85rem;line-height:1.6">
                    <%= p.deskripsi_singkat || 'Belum ada deskripsi.' %>
                  </p>

                  <div class="d-flex flex-wrap gap-2" style="gap:8px">
                    <a href="/admin/move/<%= p.id %>/edit" class="action-btn" style="background:#4e73df;color:#fff">
                      <i class="fas fa-edit"></i> Edit Info
                    </a>
                    <a href="/admin/move/<%= p.id %>/layanan" class="action-btn" style="background:#1cc88a;color:#fff">
                      <i class="fas fa-list-check"></i> Layanan
                    </a>
                    <a href="/admin/move/<%= p.id %>/galeri" class="action-btn" style="background:#f6c23e;color:#333">
                      <i class="fas fa-images"></i> Galeri
                    </a>
                    <a href="/admin/move/<%= p.id %>/sosmed" class="action-btn" style="background:#e74a3b;color:#fff">
                      <i class="fas fa-share-alt"></i> Sosmed
                    </a>
                    <a href="/admin/move/<%= p.id %>/pengelola" class="action-btn" style="background:#858796;color:#fff">
                      <i class="fas fa-users"></i> Tim
                    </a>
                    <a href="/move/<%= p.slug %>" target="_blank" class="action-btn" style="background:#f8f9fc;color:#4e73df;border:1px solid #d1d3e2">
                      <i class="fas fa-eye"></i> Preview
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
</body>
</html>
