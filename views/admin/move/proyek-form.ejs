<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title><%= title %> - Admin Panel</title>
  <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
  <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
  <style>
    .preview-img{width:100%;max-height:240px;object-fit:cover;border-radius:12px;border:2px solid #e3e6f0}
    .upload-zone{border:2px dashed #d1d3e2;border-radius:12px;padding:32px;text-align:center;cursor:pointer;transition:all .2s}
    .upload-zone:hover{border-color:#4e73df;background:#f0f4ff}
  </style>
</head>
<body id="page-top">
<div id="wrapper">
  <%- include('../partials/sidebar') %>
  <div id="content-wrapper" class="d-flex flex-column">
    <div id="content">
      <%- include('../partials/topbar', { user }) %>
      <div class="container-fluid">

        <nav aria-label="breadcrumb" class="mb-3">
          <ol class="breadcrumb" style="background:transparent;padding:0;font-size:.85rem">
            <li class="breadcrumb-item"><a href="/admin/move">Program MOVE</a></li>
            <li class="breadcrumb-item"><a href="/admin/move/<%= program.id %>/proyek"><%= program.nama %> – Proyek</a></li>
            <li class="breadcrumb-item active"><%= proyek ? 'Edit' : 'Tambah' %></li>
          </ol>
        </nav>

        <div class="d-flex align-items-center mb-4" style="gap:16px">
          <div style="width:48px;height:48px;border-radius:12px;background:<%= program.warna1 %>;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;flex-shrink:0"><i class="<%= program.icon %>"></i></div>
          <h1 class="h3 mb-0 text-gray-800"><%= proyek ? 'Edit' : 'Tambah' %> Proyek</h1>
        </div>

        <% if (error) { %><div class="alert alert-danger"><i class="fas fa-exclamation-circle mr-2"></i><%= error %></div><% } %>

        <form action="/admin/move/<%= program.id %>/proyek/<%= proyek ? proyek.id+'/edit' : 'create' %>" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row">
            <div class="col-lg-8">
              <div class="card shadow mb-4">
                <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-project-diagram mr-2"></i>Detail Proyek</h6></div>
                <div class="card-body">
                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Judul Proyek *</label>
                    <input type="text" name="judul" class="form-control form-control-lg" value="<%= proyek ? proyek.judul : '' %>" required placeholder="cth: Instalasi WiFi Masjid Al-Hidayah Kras">
                  </div>
                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Tahun Kegiatan *</label>
                        <input type="number" name="tahun" class="form-control" value="<%= proyek ? proyek.tahun : new Date().getFullYear() %>" min="2020" max="2035" required>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Lokasi</label>
                        <input type="text" name="lokasi" class="form-control" value="<%= proyek ? proyek.lokasi||'' : '' %>" placeholder="cth: Kras, Kediri">
                      </div>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Deskripsi Kegiatan</label>
                    <textarea name="deskripsi" class="form-control" rows="5" placeholder="Ceritakan kegiatan proyek ini — apa yang dikerjakan, siapa yang terlibat, dan dampaknya bagi komunitas."><%= proyek ? proyek.deskripsi||'' : '' %></textarea>
                  </div>
                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Status</label>
                        <select name="status" class="form-control">
                          <option value="published" <%= (!proyek||proyek.status==='published')?'selected':'' %>>Published (tampil di publik)</option>
                          <option value="draft" <%= (proyek&&proyek.status==='draft')?'selected':'' %>>Draft (tersembunyi)</option>
                        </select>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group">
                        <label class="font-weight-bold d-block" style="font-size:.85rem">Featured</label>
                        <div class="custom-control custom-switch mt-2">
                          <input type="hidden" name="featured" value="0">
                          <input type="checkbox" class="custom-control-input" id="featuredSwitch" name="featured" value="1" <%= (proyek&&proyek.featured)?'checked':'' %>>
                          <label class="custom-control-label" for="featuredSwitch">Tampilkan di bagian utama halaman</label>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-4">
              <div class="card shadow mb-4">
                <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-image mr-2"></i>Foto Proyek</h6></div>
                <div class="card-body">
                  <% if (proyek && proyek.gambar) { %>
                    <img src="/uploads/<%= proyek.gambar %>" class="preview-img mb-3" id="previewImg">
                  <% } else { %>
                    <img src="" class="preview-img mb-3" id="previewImg" style="display:none">
                  <% } %>
                  <div class="upload-zone" id="uploadZone" onclick="$('#fileInput').click()">
                    <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-2"></i>
                    <p class="text-muted mb-0" style="font-size:.85rem">Klik untuk upload foto</p>
                    <p class="text-muted mb-0" style="font-size:.75rem">JPG, PNG, WebP · Max 5MB</p>
                  </div>
                  <input type="file" id="fileInput" name="gambar" accept="image/*" style="display:none">
                  <% if (proyek && proyek.gambar) { %>
                    <p class="text-muted mt-2 mb-0" style="font-size:.75rem"><i class="fas fa-info-circle mr-1"></i>Upload foto baru untuk mengganti</p>
                  <% } %>
                </div>
              </div>

              <div class="card shadow mb-4">
                <div class="card-body">
                  <button type="submit" class="btn btn-primary btn-block btn-lg"><i class="fas fa-save mr-2"></i>Simpan Proyek</button>
                  <a href="/admin/move/<%= program.id %>/proyek" class="btn btn-outline-secondary btn-block mt-2"><i class="fas fa-arrow-left mr-2"></i>Kembali</a>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
<script>
  $('#fileInput').on('change', function(){
    var file = this.files[0];
    if (file) {
      var reader = new FileReader();
      reader.onload = function(e){ $('#previewImg').attr('src',e.target.result).show(); };
      reader.readAsDataURL(file);
    }
  });
</script>
</body>
</html>
