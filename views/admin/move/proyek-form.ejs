<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title><%= title %> - Admin Panel</title>
  <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
  <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
  <style>
    .upload-zone-foto { border:2px dashed #4e73df;border-radius:12px;padding:28px;text-align:center;cursor:pointer;transition:all .2s;background:#f8fbff }
    .upload-zone-foto:hover { background:#e8f0fe;border-color:#1a56db }
    .foto-thumb { position:relative;border-radius:8px;overflow:hidden;aspect-ratio:4/5 }
    .foto-thumb img { width:100%;height:100%;object-fit:cover }
    .foto-del-btn { position:absolute;top:4px;right:4px;background:rgba(220,38,38,.9);color:#fff;border:none;border-radius:50%;width:24px;height:24px;font-size:.72rem;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0 }
  </style>
</head>
<body id="page-top">
<div id="wrapper">
  <%- include('../partials/sidebar') %>
  <div id="content-wrapper" class="d-flex flex-column">
    <div id="content">
      <%- include('../partials/topbar', { user }) %>
      <div class="container-fluid">

        <nav aria-label="breadcrumb" class="mb-3">
          <ol class="breadcrumb" style="background:transparent;padding:0;font-size:.85rem">
            <li class="breadcrumb-item"><a href="/admin/move">Program MOVE</a></li>
            <li class="breadcrumb-item"><a href="/admin/move/<%= program.id %>/proyek"><%= program.nama %> – Proyek</a></li>
            <li class="breadcrumb-item active"><%= proyek ? 'Edit' : 'Tambah' %></li>
          </ol>
        </nav>

        <div class="d-flex align-items-center mb-4" style="gap:16px">
          <div style="width:48px;height:48px;border-radius:12px;background:<%= program.warna1 %>;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;flex-shrink:0">
            <i class="<%= program.icon %>"></i>
          </div>
          <h1 class="h3 mb-0 text-gray-800"><%= proyek ? 'Edit' : 'Tambah' %> Proyek — <%= program.nama %></h1>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle mr-2"></i>
            <%= typeof msg !== 'undefined' && msg ? msg : 'Berhasil disimpan!' %>
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger"><i class="fas fa-exclamation-circle mr-2"></i><%= error %></div>
        <% } %>

        <!-- ═══ FORM UTAMA (info + data) ═══ -->
        <form action="/admin/move/<%= program.id %>/proyek/<%= proyek ? proyek.id+'/edit' : 'create' %>" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="row">
            <!-- KOLOM KIRI -->
            <div class="col-lg-8">

              <!-- Informasi Dasar -->
              <div class="card shadow mb-4">
                <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-info-circle mr-2"></i>Informasi Dasar</h6></div>
                <div class="card-body">
                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Judul Layanan / Proyek *</label>
                    <input type="text" name="judul" class="form-control form-control-lg" required
                      value="<%= proyek ? proyek.judul : '' %>" placeholder="cth: Layanan Perawatan Komputer">
                  </div>
                  <div class="row">
                    <div class="col-md-4">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Tahun *</label>
                        <input type="number" name="tahun" class="form-control" required
                          value="<%= proyek ? proyek.tahun : new Date().getFullYear() %>" min="2020" max="2035">
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Tanggal Pelaksanaan</label>
                        <input type="date" name="tanggal_pelaksanaan" class="form-control"
                          value="<%= (proyek && proyek.tanggal_pelaksanaan) ? String(proyek.tanggal_pelaksanaan).substring(0,10) : '' %>">
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Status</label>
                        <select name="status" class="form-control">
                          <option value="published" <%= (!proyek||proyek.status==='published')?'selected':'' %>>Published</option>
                          <option value="draft"     <%= (proyek&&proyek.status==='draft')?'selected':'' %>>Draft</option>
                        </select>
                      </div>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Deskripsi Singkat</label>
                    <textarea name="deskripsi" class="form-control" rows="3"
                      placeholder="Ceritakan kegiatan yang dilakukan."><%= proyek ? proyek.deskripsi||'' : '' %></textarea>
                  </div>
                  <div class="form-group mb-0">
                    <div class="custom-control custom-switch mt-1">
                      <input type="checkbox" class="custom-control-input" id="featuredSwitch" name="featured" value="1" <%= (proyek&&proyek.featured)?'checked':'' %>>
                      <label class="custom-control-label" for="featuredSwitch">Tampilkan di bagian utama halaman landing page</label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Data Kuantitatif -->
              <div class="card shadow mb-4">
                <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-chart-bar mr-2"></i>Data Kuantitatif</h6></div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-4">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Jumlah Siswa</label>
                        <div class="input-group">
                          <input type="number" name="jumlah_siswa" class="form-control" min="0"
                            value="<%= proyek ? proyek.jumlah_siswa||'' : '' %>" placeholder="cth: 12">
                          <div class="input-group-append"><span class="input-group-text">orang</span></div>
                        </div>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Jumlah Item</label>
                        <input type="number" name="jumlah_item" class="form-control" min="0"
                          value="<%= proyek ? proyek.jumlah_item||'' : '' %>" placeholder="cth: 20">
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Satuan Item</label>
                        <input type="text" name="satuan_item" class="form-control"
                          value="<%= proyek ? proyek.satuan_item||'Unit' : 'Unit' %>" placeholder="Unit">
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Data Pelanggan -->
              <div class="card shadow mb-4">
                <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-building mr-2"></i>Data Pelanggan / Lokasi</h6></div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-8">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Nama Pelanggan</label>
                        <input type="text" name="nama_pelanggan" class="form-control"
                          value="<%= proyek ? proyek.nama_pelanggan||'' : '' %>" placeholder="cth: SMPN 1 Kras">
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem">Kategori</label>
                        <select name="kategori_pelanggan" class="form-control">
                          <% ['Sekolah','Masjid/Mushola','Kantor/Instansi','UMKM','Rumah Tangga','Organisasi','Lainnya'].forEach(function(k){ %>
                            <option value="<%= k %>" <%= (proyek && proyek.kategori_pelanggan===k)?'selected':'' %>><%= k %></option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Lokasi Lengkap</label>
                    <input type="text" name="lokasi" class="form-control"
                      value="<%= proyek ? proyek.lokasi||'' : '' %>" placeholder="Alamat lengkap lokasi kegiatan">
                  </div>
                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem"><i class="fas fa-map-marker-alt text-danger mr-1"></i>Link Google Maps</label>
                        <input type="url" name="link_maps" class="form-control"
                          value="<%= proyek ? proyek.link_maps||'' : '' %>" placeholder="https://maps.app.goo.gl/...">
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group">
                        <label class="font-weight-bold" style="font-size:.85rem"><i class="fab fa-instagram" style="color:#e1306c;margin-right:4px"></i>Instagram</label>
                        <input type="url" name="link_publikasi" class="form-control"
                          value="<%= proyek ? proyek.link_publikasi||'' : '' %>" placeholder="https://www.instagram.com/p/...">
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-group mb-0">
                        <label class="font-weight-bold" style="font-size:.85rem"><i class="fab fa-tiktok" style="color:#000;margin-right:4px"></i>TikTok</label>
                        <input type="url" name="link_tiktok" class="form-control"
                          value="<%= proyek ? proyek.link_tiktok||'' : '' %>" placeholder="https://www.tiktok.com/@.../video/...">
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-group mb-0">
                        <label class="font-weight-bold" style="font-size:.85rem"><i class="fab fa-youtube" style="color:#ff0000;margin-right:4px"></i>YouTube</label>
                        <input type="url" name="link_youtube" class="form-control"
                          value="<%= proyek ? proyek.link_youtube||'' : '' %>" placeholder="https://www.youtube.com/watch?v=...">
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-group mb-0">
                        <label class="font-weight-bold" style="font-size:.85rem"><i class="fab fa-facebook" style="color:#1877f2;margin-right:4px"></i>Facebook</label>
                        <input type="url" name="link_facebook" class="form-control"
                          value="<%= proyek ? proyek.link_facebook||'' : '' %>" placeholder="https://www.facebook.com/...">
                      </div>
                    </div>
                    <div class="col-md-4 mt-3">
                      <div class="form-group mb-0">
                        <label class="font-weight-bold" style="font-size:.85rem"><i class="fab fa-twitter" style="color:#1da1f2;margin-right:4px"></i>Twitter / X</label>
                        <input type="url" name="link_twitter" class="form-control"
                          value="<%= proyek ? proyek.link_twitter||'' : '' %>" placeholder="https://twitter.com/...">
                      </div>
                    </div>
                    <div class="col-md-4 mt-3">
                      <div class="form-group mb-0">
                        <label class="font-weight-bold" style="font-size:.85rem"><i class="fab fa-threads" style="color:#000;margin-right:4px"></i>Threads</label>
                        <input type="url" name="link_threads" class="form-control"
                          value="<%= proyek ? proyek.link_threads||'' : '' %>" placeholder="https://www.threads.net/...">
                      </div>
                    </div>
                  </div>
                  </div>
                </div>
              </div>

            </div>

            <!-- ANGGOTA TIM (bawah kolom kiri, full width) -->
            <div class="col-lg-8">
              <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex align-items-center justify-content-between">
                  <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-users mr-2"></i>Anggota Tim Proyek</h6>
                  <span class="badge badge-<%= (anggota && anggota.length >= 4) ? 'success' : 'info' %>">
                    <span id="anggotaCount"><%= anggota ? anggota.length : 0 %></span>/4 siswa
                  </span>
                </div>
                <div class="card-body">
                  <p class="text-muted mb-3" style="font-size:.85rem">
                    <i class="fas fa-info-circle mr-1 text-info"></i>
                    Tambahkan nama siswa dan link publikasi mereka (IG, TikTok, YouTube, dll). Platform terdeteksi otomatis dari URL.
                  </p>

                  <!-- Daftar anggota yang sudah ada -->
                  <% if (proyek && anggota && anggota.length > 0) { %>
                    <div class="mb-3" id="anggotaList">
                      <% anggota.forEach(function(a){ %>
                        <div class="d-flex align-items-center mb-2 p-2 border rounded" style="gap:10px;background:#f8f9fc" id="anggota-<%= a.id %>">
                          <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,<%= program.warna1 %>,<%= program.warna2 || '#f59e0b' %>);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.8rem;font-weight:700;flex-shrink:0">
                            <%= a.nama.charAt(0).toUpperCase() %>
                          </div>
                          <div style="flex:1;min-width:0">
                            <div style="font-weight:600;font-size:.85rem"><%= a.nama %></div>
                            <% if (a.link_publikasi) { %>
                              <a href="<%= a.link_publikasi %>" target="_blank" style="font-size:.75rem;color:#4e73df;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">
                                <%= a.link_publikasi.substring(0, 50) %><%= a.link_publikasi.length > 50 ? '...' : '' %>
                              </a>
                            <% } else { %>
                              <span style="font-size:.75rem;color:#adb5bd;font-style:italic">Belum ada link</span>
                            <% } %>
                          </div>
                          <div class="d-flex" style="gap:4px;flex-shrink:0">
                            <button type="button" class="btn btn-xs btn-outline-primary"
                              onclick="editAnggota(<%= a.id %>,'<%= a.nama.replace(/'/g, \\'\\') %>','<%= (a.link_publikasi||'').replace(/'/g, \\'\\') %>')"
                              style="font-size:.72rem;padding:3px 8px"><i class="fas fa-edit"></i></button>
                            <form action="/admin/move/<%= program.id %>/proyek/<%= proyek.id %>/anggota/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Hapus anggota ini?')" style="margin:0">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button class="btn btn-xs btn-outline-danger" style="font-size:.72rem;padding:3px 8px"><i class="fas fa-trash"></i></button>
                            </form>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>

                  <!-- Form tambah / edit anggota -->
                  <% if (proyek) { %>
                    <% var maxAnggota = 4; var anggotaCount = anggota ? anggota.length : 0; %>
                    <div id="formAnggotaWrap" style="<%= anggotaCount >= maxAnggota ? 'display:none' : '' %>">
                      <form id="formAnggota" action="/admin/move/<%= program.id %>/proyek/<%= proyek.id %>/anggota/add" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="row">
                          <div class="col-md-4">
                            <div class="form-group mb-2">
                              <label style="font-size:.82rem;font-weight:600">Nama Siswa *</label>
                              <input type="text" name="nama" id="anggotaNama" class="form-control form-control-sm" required placeholder="cth: Andi Prasetyo">
                            </div>
                          </div>
                          <div class="col-md-7">
                            <div class="form-group mb-2">
                              <label style="font-size:.82rem;font-weight:600">
                                Link Publikasi
                                <span id="platformDetect" style="font-size:.75rem;color:#4e73df;margin-left:6px"></span>
                              </label>
                              <input type="url" name="link_publikasi" id="anggotaLink" class="form-control form-control-sm"
                                placeholder="Paste link IG / TikTok / YouTube / FB / Twitter / Threads..."
                                oninput="detectPlatform(this.value)">
                              <small class="text-muted">Platform terdeteksi otomatis dari URL</small>
                            </div>
                          </div>
                          <div class="col-md-1 d-flex align-items-end">
                            <div class="form-group mb-2">
                              <button type="submit" class="btn btn-primary btn-sm" style="padding:6px 10px">
                                <i class="fas fa-plus"></i>
                              </button>
                            </div>
                          </div>
                        </div>
                      </form>
                    </div>
                    <% if (anggotaCount >= maxAnggota) { %>
                      <div class="alert alert-success py-2 mb-0" style="font-size:.82rem">
                        <i class="fas fa-check-circle mr-1"></i>Tim sudah lengkap (4 anggota). Hapus anggota untuk menambah yang baru.
                      </div>
                    <% } %>
                  <% } else { %>
                    <div class="alert alert-light border" style="font-size:.82rem">
                      <i class="fas fa-save mr-1 text-muted"></i>Simpan proyek dulu untuk menambah anggota tim.
                    </div>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- KOLOM KANAN -->
            <div class="col-lg-4">

              <!-- Foto Proyek -->
              <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex align-items-center justify-content-between">
                  <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-images mr-2"></i>Foto Proyek</h6>
                  <span class="badge badge-info"><span id="fotoCount"><%= (fotos && fotos.length) ? fotos.length : 0 %></span>/5</span>
                </div>
                <div class="card-body">
                  <!-- Grid foto yang sudah ada -->
                  <% if (proyek && fotos && fotos.length > 0) { %>
                    <p class="text-muted mb-2" style="font-size:.78rem">Klik <i class="fas fa-times text-danger"></i> untuk hapus:</p>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px">
                      <% fotos.forEach(function(f){ %>
                        <div class="foto-thumb">
                          <img src="/uploads/<%= f.gambar %>" alt="foto">
                          <button type="button" class="foto-del-btn" onclick="hapusFoto(<%= f.id %>, this)">
                            <i class="fas fa-times"></i>
                          </button>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>

                  <!-- Area upload (hanya tampil jika proyek sudah ada dan foto < 5) -->
                  <% if (proyek) { %>
                    <% var fotoCount = (fotos && fotos.length) ? fotos.length : 0; %>
                    <% if (fotoCount < 5) { %>
                      <!-- Tombol upload — diklik via JS, form foto ada di LUAR form ini -->
                      <div class="upload-zone-foto" onclick="document.getElementById('fotoMultiInput').click()">
                        <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color:#4e73df"></i>
                        <p class="mb-1 font-weight-bold" style="font-size:.9rem;color:#4e73df">Klik untuk pilih foto</p>
                        <p class="mb-0 text-muted" style="font-size:.75rem">Pilih beberapa sekaligus · Maks <%= 5 - fotoCount %> foto lagi</p>
                      </div>
                    <% } else { %>
                      <div class="alert alert-success py-2 mb-0" style="font-size:.82rem">
                        <i class="fas fa-check-circle mr-1"></i>Sudah 5 foto (maksimal). Hapus foto untuk upload yang baru.
                      </div>
                    <% } %>
                    <p class="text-muted mt-2 mb-0" style="font-size:.72rem;text-align:center">
                      <i class="fas fa-compress-arrows-alt mr-1 text-success"></i>Auto-compress ke WebP portrait 800×1000px
                    </p>
                  <% } else { %>
                    <div style="border:2px dashed #d1d3e2;border-radius:12px;padding:24px;text-align:center;background:#f8f9fc">
                      <i class="fas fa-save fa-2x text-muted mb-2 d-block"></i>
                      <p class="text-muted mb-0" style="font-size:.85rem">Simpan proyek dulu, baru bisa upload foto</p>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Preview Caption -->
              <div class="card shadow mb-4 border-left-info">
                <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-info"><i class="fas fa-eye mr-2"></i>Preview Caption</h6></div>
                <div class="card-body" style="font-size:.82rem;line-height:1.7;color:#5a5c69">
                  <p class="mb-1"><strong id="pv_judul">Judul Proyek</strong></p>
                  <p class="mb-1" id="pv_tanggal" style="display:none">📅 <span></span></p>
                  <p class="mb-1" id="pv_siswa"   style="display:none">👨‍🎓 <span></span></p>
                  <p class="mb-1" id="pv_item"    style="display:none">🔧 <span></span></p>
                  <p class="mb-1" id="pv_pelanggan" style="display:none">🏢 <span></span></p>
                  <p class="mb-1" id="pv_lokasi"  style="display:none">📍 <span></span></p>
                </div>
              </div>

              <!-- Simpan -->
              <div class="card shadow mb-4">
                <div class="card-body">
                  <button type="submit" class="btn btn-primary btn-block btn-lg">
                    <i class="fas fa-save mr-2"></i>Simpan Proyek
                  </button>
                  <a href="/admin/move/<%= program.id %>/proyek" class="btn btn-outline-secondary btn-block mt-2">
                    <i class="fas fa-arrow-left mr-2"></i>Kembali
                  </a>
                </div>
              </div>

            </div>
          </div>
        </form>

        <!-- ═══ FORM UPLOAD FOTO — DI LUAR FORM UTAMA ═══ -->
        <% if (proyek) { %>
        <form id="formFotoUpload"
              action="/admin/move/<%= program.id %>/proyek/<%= proyek.id %>/foto/upload"
              method="POST" enctype="multipart/form-data" style="display:none">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="file" id="fotoMultiInput" name="foto_baru" accept="image/*" multiple
            onchange="this.form.submit()">
        </form>
        <% } %>

      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>
<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
<script>
// Live preview caption
function updatePreview() {
  var judul    = document.querySelector('[name=judul]').value;
  var tgl      = document.querySelector('[name=tanggal_pelaksanaan]').value;
  var siswa    = document.querySelector('[name=jumlah_siswa]').value;
  var item     = document.querySelector('[name=jumlah_item]').value;
  var satuan   = document.querySelector('[name=satuan_item]').value || 'Unit';
  var pelanggan= document.querySelector('[name=nama_pelanggan]').value;
  var kategori = document.querySelector('[name=kategori_pelanggan]').value;
  var lokasi   = document.querySelector('[name=lokasi]').value;

  document.getElementById('pv_judul').textContent = judul || 'Judul Proyek';

  var elTgl = document.getElementById('pv_tanggal');
  if (tgl) { var d=new Date(tgl); elTgl.querySelector('span').textContent='Pelaksanaan: '+d.toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}); elTgl.style.display=''; }
  else { elTgl.style.display='none'; }

  var elSiswa = document.getElementById('pv_siswa');
  if (siswa) { elSiswa.querySelector('span').textContent='Jumlah Siswa: '+siswa+' orang'; elSiswa.style.display=''; }
  else { elSiswa.style.display='none'; }

  var elItem = document.getElementById('pv_item');
  if (item) { elItem.querySelector('span').textContent='Jumlah: '+item+' '+satuan; elItem.style.display=''; }
  else { elItem.style.display='none'; }

  var elPelanggan = document.getElementById('pv_pelanggan');
  if (pelanggan) { elPelanggan.querySelector('span').textContent='Pelanggan: '+pelanggan+(kategori?' ('+kategori+')':''); elPelanggan.style.display=''; }
  else { elPelanggan.style.display='none'; }

  var elLokasi = document.getElementById('pv_lokasi');
  if (lokasi) { elLokasi.querySelector('span').textContent=lokasi; elLokasi.style.display=''; }
  else { elLokasi.style.display='none'; }
}

['judul','tanggal_pelaksanaan','jumlah_siswa','jumlah_item','satuan_item','nama_pelanggan','kategori_pelanggan','lokasi'].forEach(function(n){
  var el = document.querySelector('[name='+n+']');
  if (el) el.addEventListener('input', updatePreview);
  if (el && el.tagName === 'SELECT') el.addEventListener('change', updatePreview);
});
updatePreview();

// Deteksi platform dari URL
function detectPlatform(url) {
  var el = document.getElementById('platformDetect');
  if (!url) { el.textContent = ''; return; }
  var platforms = [
    { pattern: /instagram\.com/i,  label: '📸 Instagram',  color: '#e1306c' },
    { pattern: /tiktok\.com/i,     label: '🎵 TikTok',     color: '#000000' },
    { pattern: /youtube\.com|youtu\.be/i, label: '📺 YouTube', color: '#ff0000' },
    { pattern: /facebook\.com/i,   label: '👍 Facebook',   color: '#1877f2' },
    { pattern: /twitter\.com|x\.com/i, label: '🐦 Twitter/X', color: '#1da1f2' },
    { pattern: /threads\.net/i,    label: '🔗 Threads',    color: '#000000' },
    { pattern: /wa\.me|whatsapp/i, label: '💬 WhatsApp',   color: '#25d366' }
  ];
  for (var i = 0; i < platforms.length; i++) {
    if (platforms[i].pattern.test(url)) {
      el.textContent = '→ ' + platforms[i].label;
      el.style.color = platforms[i].color;
      return;
    }
  }
  el.textContent = '🔗 Link Lainnya';
  el.style.color = '#64748b';
}

// Edit anggota (isi form tambah dengan data existing, ganti action ke edit)
function editAnggota(id, nama, link) {
  var form = document.getElementById('formAnggota');
  if (!form) return;
  document.getElementById('anggotaNama').value = nama;
  document.getElementById('anggotaLink').value = link;
  detectPlatform(link);
  form.action = form.action.replace('/anggota/add', '/anggota/' + id + '/edit');
  document.getElementById('formAnggotaWrap').style.display = '';
  document.getElementById('formAnggotaWrap').scrollIntoView({ behavior: 'smooth', block: 'center' });
  // Ganti label tombol
  form.querySelector('button[type=submit]').innerHTML = '<i class="fas fa-save"></i>';
  // Tombol batal
  if (!document.getElementById('btnBatalEdit')) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.id = 'btnBatalEdit';
    btn.className = 'btn btn-outline-secondary btn-sm ml-1';
    btn.style = 'padding:6px 10px';
    btn.innerHTML = '<i class="fas fa-times"></i>';
    btn.onclick = function() {
      form.reset();
      form.action = form.action.replace(/\/anggota\/\d+\/edit/, '/anggota/add');
      form.querySelector('button[type=submit]').innerHTML = '<i class="fas fa-plus"></i>';
      document.getElementById('platformDetect').textContent = '';
      this.remove();
    };
    form.querySelector('button[type=submit]').parentNode.appendChild(btn);
  }
}
function hapusFoto(id, btn) {
  if (!confirm('Hapus foto ini?')) return;
  var progId = '<%= program.id %>';
  var pid    = '<%= proyek ? proyek.id : 0 %>';
  var csrf   = '<%= csrfToken %>';
  fetch('/admin/move/' + progId + '/proyek/' + pid + '/foto/' + id + '/delete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: '_csrf=' + encodeURIComponent(csrf)
  }).then(function() {
    btn.closest('.foto-thumb').remove();
    var cnt = parseInt(document.getElementById('fotoCount').textContent) - 1;
    document.getElementById('fotoCount').textContent = cnt;
  }).catch(function() { location.reload(); });
}
</script>
</body>
</html>
