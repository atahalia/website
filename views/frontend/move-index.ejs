<script src="/assets/vendor/leaflet/leaflet.js"></script>
<script>
  // ── Smooth scroll ────────────────────────────────────
  document.querySelectorAll('a[href^="#"]').forEach(function(el){
    el.addEventListener('click',function(e){
      var t=document.querySelector(this.getAttribute('href'));
      if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'});}
    });
  });

  // ── Filter Proyek ────────────────────────────────────
  var activeJurusan = 'all', activeTahun = 'all';

  function applyFilter() {
    document.querySelectorAll('.pitem').forEach(function(el){
      var j = el.dataset.jurusan, t = el.dataset.tahun;
      var showJ = (activeJurusan === 'all' || j === activeJurusan);
      var showT = (activeTahun === 'all' || t == activeTahun);
      el.style.display = (showJ && showT) ? '' : 'none';
    });
  }

  document.querySelectorAll('.idx-filter').forEach(function(btn){
    btn.addEventListener('click', function(){
      activeJurusan = this.dataset.val;
      document.querySelectorAll('.idx-filter').forEach(function(b){
        b.style.background='#fff'; b.style.color='#64748b'; b.style.borderColor='#e2e8f0';
      });
      var color = this.dataset.color || '#1a56db';
      if (activeJurusan === 'all') color = '#1e3a5f';
      this.style.background = color; this.style.color='#fff'; this.style.borderColor=color;
      applyFilter();
    });
  });

  document.querySelectorAll('.idx-filter-tahun').forEach(function(btn){
    btn.addEventListener('click', function(){
      activeTahun = this.dataset.val;
      document.querySelectorAll('.idx-filter-tahun').forEach(function(b){
        b.style.background='#fff'; b.style.color='#64748b'; b.style.borderColor='#e2e8f0';
      });
      this.style.background='#1e3a5f'; this.style.color='#fff'; this.style.borderColor='#1e3a5f';
      applyFilter();
    });
  });

  // ── Filter Galeri ────────────────────────────────────────────────
  document.querySelectorAll('.galeri-filter-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var slug = this.dataset.slug;
      document.querySelectorAll('.galeri-filter-btn').forEach(function(b){
        b.style.background='#fff'; b.style.color='#64748b'; b.style.borderColor='#e2e8f0';
      });
      var color = this.dataset.color || '#1e3a5f';
      if (slug === 'all') color = '#1e3a5f';
      this.style.background = color; this.style.color='#fff'; this.style.borderColor=color;
      document.querySelectorAll('.galeri-idx-item').forEach(function(el){
        el.style.display = (slug === 'all' || el.dataset.slug === slug) ? '' : 'none';
      });
    });
  });

  // Lightbox — baca dari data attributes
  function openLightboxData(el) {
    openLightbox(el.dataset.src, decodeURIComponent(el.dataset.caption||''), decodeURIComponent(el.dataset.jurusan||''));
  }
  function openLightbox(src, caption, jurusan) {
    var ol = document.getElementById('lightboxOverlay');
    document.getElementById('lightboxImg').src = src;
    document.getElementById('lightboxCaption').textContent = caption || '';
    document.getElementById('lightboxJurusan').textContent = jurusan ? 'MOVE ' + jurusan : '';
    ol.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    document.getElementById('lightboxOverlay').style.display = 'none';
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', function(e){ if (e.key==='Escape') closeLightbox(); });

  // ── Slider proyek index ────────────────────────────────────────
  (function(){
    document.querySelectorAll('.proyek-slider-idx').forEach(function(slider){
      var slides = slider.querySelectorAll('.slide-item-idx');
      var dots   = slider.querySelectorAll('.dot-idx');
      if (slides.length <= 1) return;
      var cur = 0;
      function goTo(n) {
        slides[cur].style.opacity='0'; slides[cur].style.zIndex='0';
        dots[cur] && (dots[cur].style.width='7px', dots[cur].style.background='rgba(255,255,255,.5)');
        cur = (n + slides.length) % slides.length;
        slides[cur].style.opacity='1'; slides[cur].style.zIndex='1';
        dots[cur] && (dots[cur].style.width='18px', dots[cur].style.background='rgba(255,255,255,.95)');
      }
      var t = setInterval(function(){ goTo(cur+1); }, 3000);
      dots.forEach(function(d,i){ d.addEventListener('click',function(e){ e.stopPropagation(); clearInterval(t); goTo(i); t=setInterval(function(){goTo(cur+1);},3000); }); });
      slider.addEventListener('mouseenter',function(){ clearInterval(t); });
      slider.addEventListener('mouseleave',function(){ t=setInterval(function(){goTo(cur+1);},3000); });
    });
  })();

  // ── Peta Gabungan Leaflet ────────────────────────────
  if (document.getElementById('moveIndexMap')) {
    var idxMap = L.map('moveIndexMap').setView([-7.822, 112.012], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© <a href="https://openstreetmap.org">OpenStreetMap</a> contributors'
    }).addTo(idxMap);

    function makePin(color) {
      var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="38" viewBox="0 0 28 38">'
        + '<ellipse cx="14" cy="35" rx="5" ry="2" fill="rgba(0,0,0,0.15)"/>'
        + '<path d="M14 0C8.477 0 4 4.477 4 10c0 7.5 10 24 10 24S24 17.5 24 10C24 4.477 19.523 0 14 0z" fill="'
        + color + '" stroke="rgba(0,0,0,.1)" stroke-width="0.5"/>'
        + '<circle cx="14" cy="10" r="5" fill="white" opacity="0.9"/></svg>';
      return L.divIcon({ html:svg, iconSize:[28,38], iconAnchor:[14,38], popupAnchor:[0,-36], className:'' });
    }

    fetch('/api/move/pelanggan')
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (!data.length) return;
        var bounds = [];
        data.forEach(function(k){
          var icon = makePin(k.warna1 || '#1e3a5f');
          var googleUrl = 'https://www.google.com/maps?q='+k.lat+','+k.lng;
          var popup = '<div style="min-width:200px;font-family:Inter,sans-serif">'
            + '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">'
            + '<span style="width:10px;height:10px;border-radius:50%;background:'+(k.warna1||'#1e3a5f')+';display:inline-block"></span>'
            + '<span style="font-size:.72rem;font-weight:700;color:'+(k.warna1||'#1e3a5f')+'">MOVE '+k.program_nama.replace('Teknik Komputer Jaringan','TKJ').replace('Teknik Kendaraan Ringan','TKR').replace('Teknik Pemanasan, Tata Udara, dan Pendinginan','TPTUP').replace('Tata Boga','Kuliner')+'</span>'
            + '</div>'
            + '<strong style="font-size:.92rem;color:#0f172a;line-height:1.4;display:block;margin-bottom:6px">'+k.nama+'</strong>'
            + (k.alamat ? '<div style="font-size:.78rem;color:#64748b;margin-bottom:4px">📍 '+k.alamat+'</div>' : '')
            + (k.layanan ? '<div style="font-size:.78rem;color:#64748b;margin-bottom:4px">🔧 '+k.layanan+'</div>' : '')
            + '<div style="font-size:.75rem;color:#94a3b8;margin-bottom:10px">Tahun '+k.tahun+'</div>'
            + '<a href="'+googleUrl+'" target="_blank" style="display:inline-flex;align-items:center;gap:6px;background:#1a56db;color:#fff;padding:6px 14px;border-radius:20px;font-size:.75rem;font-weight:600;text-decoration:none">'
            + '📍 Buka di Google Maps</a></div>';
          L.marker([k.lat,k.lng],{icon:icon}).addTo(idxMap).bindPopup(popup,{maxWidth:240});
          bounds.push([k.lat,k.lng]);
        });
        if (bounds.length) idxMap.fitBounds(bounds,{padding:[40,40],maxZoom:14});
      })
      .catch(function(){ console.warn('Gagal memuat data peta'); });
  }
</script>
</body>
</html>
