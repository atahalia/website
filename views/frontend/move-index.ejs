<!-- GALERI GABUNGAN SEMUA JURUSAN -->
<% if (allGaleri && allGaleri.length > 0) { %>
<section class="section-pad-sm" style="background:#f8fafc" id="galeri-index">
  <div class="container">
    <div class="d-flex align-items-end justify-content-between mb-4 flex-wrap" style="gap:12px">
