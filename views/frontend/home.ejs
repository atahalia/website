                style="background:rgba(255,255,255,.15);border:1.5px solid rgba(255,255,255,.35);color:white;border-radius:20px;padding:.2rem .75rem;font-size:.72rem;font-weight:700;cursor:pointer;transition:all .2s;">
                <i class="fas fa-flag me-1"></i><span id="jp-toggle-label">Ada Upacara</span>
              </button>
            </div>
            <div style="color:rgba(255,255,255,.7);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;font-weight:600;">Sisa waktu</div>
            <div id="jp-countdown" style="color:#4ade80;font-size:1.05rem;font-weight:800;font-variant-numeric:tabular-nums;">--:--</div>
            <div style="background:rgba(255,255,255,.2);border-radius:99px;height:5px;margin-top:.35rem;overflow:hidden;">
              <div id="jp-progress" style="background:linear-gradient(90deg,#4ade80,#22d3ee);height:100%;border-radius:99px;width:0%;transition:width .5s;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
