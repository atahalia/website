<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title><%= title %> - Admin Panel</title>
  <link rel="icon" type="image/png" href="/assets/img/favicon.png?v=4">
  <link href="/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/sb-admin-2.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
  <style>
    #adminMap { height: 420px; border-radius: 12px; border: 2px solid #e3e6f0; }
    .pelanggan-row { background:#fff; border-radius:10px; border:1px solid #e3e6f0; padding:14px 16px; margin-bottom:10px; }
    .koordinat-display { font-family:monospace; font-size:.82rem; background:#f8f9fc; border-radius:6px; padding:4px 10px; color:#4e73df; }
    .pick-hint { background:#e8f4fd; border-radius:8px; padding:10px 14px; font-size:.82rem; color:#1a56db; border-left:3px solid #1a56db; }
  </style>
</head>
<body id="page-top">
<div id="wrapper">
  <%- include('../partials/sidebar') %>
  <div id="content-wrapper" class="d-flex flex-column">
    <div id="content">
      <%- include('../partials/topbar', { user }) %>
      <div class="container-fluid">

        <nav aria-label="breadcrumb" class="mb-3">
          <ol class="breadcrumb" style="background:transparent;padding:0;font-size:.85rem">
            <li class="breadcrumb-item"><a href="/admin/move">Program MOVE</a></li>
            <li class="breadcrumb-item"><a href="/admin/move/<%= program.id %>/edit"><%= program.nama %></a></li>
            <li class="breadcrumb-item active">Peta Pelanggan</li>
          </ol>
        </nav>

        <div class="d-flex align-items-center justify-content-between mb-4">
          <div class="d-flex align-items-center" style="gap:16px">
            <div style="width:48px;height:48px;border-radius:12px;background:<%= program.warna1 %>;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;flex-shrink:0"><i class="<%= program.icon %>"></i></div>
            <div><h1 class="h3 mb-0 text-gray-800">Peta Pelanggan</h1><p class="text-muted mb-0" style="font-size:.85rem"><%= program.nama %> · <%= pelanggan.length %> titik</p></div>
          </div>
        </div>

        <div class="d-flex flex-wrap mb-4" style="gap:8px">
          <a href="/admin/move/<%= program.id %>/edit"      class="btn btn-sm btn-outline-primary"><i class="fas fa-info-circle mr-1"></i>Info</a>
          <a href="/admin/move/<%= program.id %>/layanan"   class="btn btn-sm btn-outline-success"><i class="fas fa-list-check mr-1"></i>Layanan</a>
          <a href="/admin/move/<%= program.id %>/proyek"    class="btn btn-sm btn-outline-info"><i class="fas fa-project-diagram mr-1"></i>Proyek</a>
          <a href="/admin/move/<%= program.id %>/berita"    class="btn btn-sm btn-outline-secondary"><i class="fas fa-newspaper mr-1"></i>Berita</a>
          <a href="/admin/move/<%= program.id %>/pelanggan" class="btn btn-sm btn-warning text-white"><i class="fas fa-map-marker-alt mr-1"></i>Peta</a>
          <a href="/admin/move/<%= program.id %>/galeri"    class="btn btn-sm btn-outline-warning"><i class="fas fa-images mr-1"></i>Galeri</a>
          <a href="/admin/move/<%= program.id %>/sosmed"    class="btn btn-sm btn-outline-danger"><i class="fas fa-share-alt mr-1"></i>Sosmed</a>
          <a href="/admin/move/<%= program.id %>/pengelola" class="btn btn-sm btn-outline-secondary"><i class="fas fa-users mr-1"></i>Tim</a>
        </div>

        <% if (success) { %><div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>Berhasil disimpan!<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button></div><% } %>
        <% if (error) { %><div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle mr-2"></i><%= error %><button type="button" class="close" data-dismiss="alert"><span>&times;</span></button></div><% } %>

        <div class="row">
          <!-- Form tambah pelanggan -->
          <div class="col-lg-4 mb-4">
            <div class="card shadow">
              <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-map-pin mr-2"></i>Tambah Titik Lokasi</h6></div>
              <div class="card-body">

                <div class="pick-hint mb-3">
                  <i class="fas fa-hand-pointer mr-2"></i><strong>Cara input koordinat:</strong><br>
                  Klik titik di peta sebelah kanan, koordinat akan terisi otomatis. Atau ketik manual / paste dari Google Maps.
                </div>

                <form action="/admin/move/<%= program.id %>/pelanggan/add" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Nama Pelanggan / Lokasi *</label>
                    <input type="text" name="nama" class="form-control" required placeholder="cth: Masjid Al-Hidayah Kras">
                  </div>
                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Alamat</label>
                    <input type="text" name="alamat" class="form-control" placeholder="cth: Kras, Kediri, Jawa Timur">
                  </div>
                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Layanan yang Diberikan</label>
                    <input type="text" name="layanan" class="form-control" placeholder="cth: Instalasi Jaringan WiFi">
                  </div>
                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Tahun</label>
                    <input type="number" name="tahun" class="form-control" value="<%= new Date().getFullYear() %>" min="2020" max="2035">
                  </div>

                  <!-- Koordinat -->
                  <div class="mb-2">
                    <label class="font-weight-bold" style="font-size:.85rem">Koordinat <span class="text-danger">*</span></label>
                    <div id="koordinatDisplay" class="koordinat-display mb-2">Klik peta untuk pilih lokasi</div>
                  </div>
                  <div class="row">
                    <div class="col-6">
                      <div class="form-group">
                        <label style="font-size:.78rem;color:#858796">Latitude</label>
                        <input type="text" name="lat" id="latInput" class="form-control form-control-sm" placeholder="-7.8234567" required style="font-family:monospace">
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="form-group">
                        <label style="font-size:.78rem;color:#858796">Longitude</label>
                        <input type="text" name="lng" id="lngInput" class="form-control form-control-sm" placeholder="112.0123456" required style="font-family:monospace">
                      </div>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="font-weight-bold" style="font-size:.85rem">Keterangan Tambahan</label>
                    <textarea name="keterangan" class="form-control" rows="2" placeholder="Catatan tambahan..."></textarea>
                  </div>

                  <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-map-pin mr-2"></i>Tambah ke Peta</button>
                </form>

                <!-- Cara cari koordinat dari Google Maps -->
                <div class="alert alert-light border mt-3 mb-0" style="font-size:.78rem;border-radius:8px">
                  <strong><i class="fab fa-google mr-1"></i>Cara dari Google Maps:</strong><br>
                  Buka Google Maps → cari lokasi → klik kanan titiknya → angka pertama = Latitude, kedua = Longitude.
                </div>
              </div>
            </div>
          </div>

          <!-- Peta admin (klik untuk pilih koordinat) -->
          <div class="col-lg-8 mb-4">
            <div class="card shadow">
              <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-map mr-2"></i>Peta Semua Program MOVE</h6>
                <a href="/move/peta" target="_blank" class="btn btn-sm btn-outline-primary"><i class="fas fa-external-link-alt mr-1"></i>Lihat Peta Publik</a>
              </div>
              <div class="card-body p-2">
                <div id="adminMap"></div>
                <p class="text-muted mt-2 mb-0" style="font-size:.78rem"><i class="fas fa-info-circle mr-1"></i>Klik di peta untuk memilih koordinat lokasi baru. Peta menampilkan semua program MOVE.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Daftar pelanggan -->
        <div class="card shadow mb-4">
          <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-list mr-2"></i>Daftar Titik Lokasi (<%= pelanggan.length %>)</h6></div>
          <div class="card-body">
            <% if (!pelanggan.length) { %>
              <div class="text-center py-4 text-muted"><i class="fas fa-map-marker-alt fa-2x mb-2 d-block" style="opacity:.3"></i>Belum ada titik lokasi.</div>
            <% } else { %>
              <div class="row">
                <% pelanggan.forEach(function(k){ %>
                  <div class="col-md-6 col-lg-4">
                    <div class="pelanggan-row">
                      <div class="d-flex align-items-start justify-content-between">
                        <div>
                          <strong style="font-size:.88rem"><%= k.nama %></strong><br>
                          <% if(k.alamat){ %><span class="text-muted" style="font-size:.78rem"><i class="fas fa-map-marker-alt mr-1"></i><%= k.alamat %></span><br><% } %>
                          <% if(k.layanan){ %><span class="text-muted" style="font-size:.78rem"><i class="fas fa-tools mr-1"></i><%= k.layanan %></span><br><% } %>
                          <span class="badge badge-light mt-1" style="font-size:.72rem"><i class="fas fa-calendar mr-1"></i><%= k.tahun %></span>
                          <div class="koordinat-display mt-1" style="font-size:.72rem"><%= parseFloat(k.lat).toFixed(6) %>, <%= parseFloat(k.lng).toFixed(6) %></div>
                        </div>
                        <form action="/admin/move/pelanggan/<%= k.id %>/delete" method="POST" onsubmit="return confirm('Hapus titik ini?')" style="margin:0;flex-shrink:0">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button class="btn btn-xs btn-outline-danger ml-2" style="font-size:.72rem;padding:3px 8px"><i class="fas fa-trash"></i></button>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>

<script src="/assets/vendor/jquery/jquery.min.js"></script>
<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/vendor/leaflet/leaflet.js"></script>
<script src="/assets/js/sb-admin-2.min.js"></script>
<script>
var allPrograms = <%- JSON.stringify(allPrograms) %>;
var pelangganData = <%- JSON.stringify(pelanggan) %>;
var programId = <%= program.id %>;
var programWarna = '<%= program.warna1 %>';

// Warna per program slug
var colorMap = { tkj:'#1e3a5f', tptup:'#0c4a6e', boga:'#064e3b', tkr:'#7f1d1d' };

// Inisialisasi peta admin (center Kras, Kediri)
var adminMap = L.map('adminMap').setView([-7.822, 112.012], 13);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  maxZoom: 19,
  attribution: '© <a href="https://openstreetmap.org">OpenStreetMap</a>'
}).addTo(adminMap);

// Tampilkan semua titik dari API
fetch('/api/move/pelanggan')
  .then(function(r){ return r.json(); })
  .then(function(data){
    data.forEach(function(k){
      var warna = colorMap[k.program_slug] || '#4e73df';
      var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="38" viewBox="0 0 28 38">'
        + '<ellipse cx="14" cy="35" rx="5" ry="2" fill="rgba(0,0,0,0.2)"/>'
        + '<path d="M14 0C8.477 0 4 4.477 4 10c0 7.5 10 24 10 24S24 17.5 24 10C24 4.477 19.523 0 14 0z" fill="' + warna + '"/>'
        + '<circle cx="14" cy="10" r="5" fill="white"/>'
        + '</svg>';
      var icon = L.divIcon({ html: svg, iconSize:[28,38], iconAnchor:[14,38], popupAnchor:[0,-36], className:'' });
      var googleMapsUrl = 'https://www.google.com/maps?q=' + k.lat + ',' + k.lng;
      var popup = '<div style="min-width:180px">'
        + '<strong style="font-size:.9rem">' + k.nama + '</strong><br>'
        + (k.alamat ? '<span style="font-size:.78rem;color:#666"><i class="fas fa-map-marker-alt" style="margin-right:4px"></i>' + k.alamat + '</span><br>' : '')
        + '<span style="font-size:.78rem;color:#666"><i class="fas fa-tools" style="margin-right:4px"></i>' + (k.layanan||'-') + '</span><br>'
        + '<span style="font-size:.75rem;color:#666"><i class="fas fa-graduation-cap" style="margin-right:4px"></i>' + k.program_nama + ' · ' + k.tahun + '</span><br>'
        + '<a href="' + googleMapsUrl + '" target="_blank" style="font-size:.78rem;color:#1a56db;font-weight:600;display:inline-block;margin-top:6px">'
        + '<i class="fas fa-external-link-alt" style="margin-right:4px"></i>Buka di Google Maps</a>'
        + '</div>';
      L.marker([k.lat, k.lng], { icon: icon }).addTo(adminMap).bindPopup(popup);
    });
  });

// Klik peta untuk pilih koordinat
var tempMarker = null;
adminMap.on('click', function(e){
  var lat = e.latlng.lat.toFixed(7);
  var lng = e.latlng.lng.toFixed(7);
  $('#latInput').val(lat);
  $('#lngInput').val(lng);
  $('#koordinatDisplay').text(lat + ', ' + lng);
  if (tempMarker) adminMap.removeLayer(tempMarker);
  var sv = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="38" viewBox="0 0 28 38">'
    + '<path d="M14 0C8.477 0 4 4.477 4 10c0 7.5 10 24 10 24S24 17.5 24 10C24 4.477 19.523 0 14 0z" fill="#22c55e"/>'
    + '<circle cx="14" cy="10" r="5" fill="white"/></svg>';
  var ic = L.divIcon({ html: sv, iconSize:[28,38], iconAnchor:[14,38], className:'' });
  tempMarker = L.marker([lat, lng], { icon: ic }).addTo(adminMap).bindPopup('Lokasi baru dipilih').openPopup();
});
</script>
</body>
</html>
