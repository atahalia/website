                                </div>
                                <div>
                                    <div class="hero-card-label"><%= s2Label %></div>
                                    <div class="hero-card-value"><%= s2Val %><%= s2Suffix %></div>
                                </div>
                            </div>
                            <div class="hero-card-float">
                                <div class="hero-card-icon" style="background:linear-gradient(135deg,#10b981,#34d399);">
                                    <i class="fas fa-award" style="color:white;"></i>
                                </div>
                                <div>
                                    <div class="hero-card-label"><%= s4Label %></div>
                                    <div class="hero-card-value"><%= s4Val %><%= s4Suffix %></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Scroll hint -->
                <div class="hero-scroll-hint">
                    <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
                    <span>Scroll</span>
                </div>
            </div>
        <% } %>
    </section>

    <!-- Colorful Ticker Strip -->
    <div class="ticker-section">
        <div class="ticker-track" id="tickerTrack">
            <%
            const defaultTicker = 'Pendidikan Berkualitas,Fasilitas Modern,Guru Berpengalaman,Prestasi Gemilang,Karakter Unggul,Siap Kerja,Inovasi & Kreativitas,Lingkungan Kondusif';
            const tickerRaw = (typeof siteSettings !== 'undefined' && siteSettings.ticker_items) ? siteSettings.ticker_items : defaultTicker;
            const tickerItems = tickerRaw.split(',').map(function(t){ return t.trim(); }).filter(Boolean);
            %>
            <% tickerItems.forEach(t => { %><span class="ticker-item"><%= t %></span><% }) %>
            <% tickerItems.forEach(t => { %><span class="ticker-item"><%= t %></span><% }) %>
        </div>
    </div>

﻿﻿    <!-- ===== BANNER JAM PELAJARAN ===== -->
    <div id="jam-pelajaran-banner" style="background:linear-gradient(135deg,#1e3a5f 0%,#1a56db 100%);padding:0;overflow:hidden;">
      <div class="container py-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
